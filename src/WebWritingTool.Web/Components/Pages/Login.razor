@page "/login"
@attribute [AllowAnonymous]

<PageTitle>ログイン</PageTitle>

<div class="auth-page">
    <section class="article-panel auth-card">
        <h1 class="h3 mb-3">ログイン</h1>

        @if (AccountDeleted)
        {
            <div class="alert alert-success" role="status">アカウントを削除しました。</div>
        }

        @if (LoginError == "invalid")
        {
            <div class="alert alert-danger" role="alert">メールアドレスまたはパスワードが正しくありません。</div>
        }
        else if (LoginError == "disabled")
        {
            <div class="alert alert-danger" role="alert">このアカウントは無効です。</div>
        }

        <form method="post" action="@GetFormAction()" class="auth-form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="mb-3">
                <label class="form-label" for="email">メールアドレス</label>
                <input id="email" name="email" type="email" class="form-control" autocomplete="username" required />
            </div>

            <div class="mb-3">
                <label class="form-label" for="password">パスワード</label>
                <input id="password" name="password" type="password" class="form-control" autocomplete="current-password" required />
            </div>

            <div class="form-check mb-3">
                <input id="remember-me" name="rememberMe" type="checkbox" value="true" class="form-check-input" />
                <label class="form-check-label" for="remember-me">ログイン状態を保持</label>
            </div>

            <button type="submit" class="btn btn-primary w-100">ログイン</button>
        </form>

        <form method="post" action="/login/guest" class="mt-4">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <button type="submit" class="btn btn-outline-primary w-100">ゲストとして試す</button>
            <p class="small text-muted mt-2 mb-0">登録不要で記事作成を試せます。生成・検索はサンプルを使用し、外部APIへの接続、WordPress投稿、Discord通知は行いません。ログアウト後は同じゲストデータに戻れません。データはゲスト利用開始から8時間経過後に自動削除します（処理中の場合は完了後）。</p>
        </form>
    </section>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public bool AccountDeleted { get; set; }

    [SupplyParameterFromQuery]
    public string? LoginError { get; set; }

    private string GetFormAction()
    {
        if (string.IsNullOrWhiteSpace(ReturnUrl))
        {
            return "/login";
        }

        if (!ReturnUrl.StartsWith("/", StringComparison.Ordinal)
            || ReturnUrl.StartsWith("//", StringComparison.Ordinal)
            || ReturnUrl.Contains("://", StringComparison.Ordinal))
        {
            return "/login";
        }

        return $"/login?returnUrl={Uri.EscapeDataString(ReturnUrl)}";
    }
}
