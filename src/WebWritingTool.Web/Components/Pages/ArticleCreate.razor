@page "/articles/create"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable

@using System.Security.Claims
@using System.Text.Json
@using WebWritingTool.Application.Generation
@using WebWritingTool.Application.Jobs
@using WebWritingTool.Domain.Jobs

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IServiceScopeFactory ScopeFactory
@inject WebWritingTool.Application.Security.ExternalApiExecutionContext ExecutionContext

<PageTitle>記事作成</PageTitle>

<div class="article-page">
    <header class="article-page-header">
        <div>
            <h1>記事作成</h1>
        </div>
        <a class="btn btn-outline-secondary" href="articles">一覧へ戻る</a>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    <EditForm Model="form" OnValidSubmit="CreateAsync" FormName="create-article">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <section class="article-panel mb-3">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4">
                    <label class="form-label" for="keyword">キーワード <span class="required-label">必須</span></label>
                    <InputText id="keyword" class="form-control" @bind-Value="form.Keyword" />
                    <ValidationMessage For="() => form.Keyword" />
                </div>
                <div class="col-lg-4">
                    <button type="button" id="generate-titles" class="btn btn-outline-secondary w-100" disabled="@(!CanGenerateTitleCandidates)" @onclick="GenerateTitleCandidatesAsync">
                        @if (isGeneratingTitles)
                        {
                            <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                        }
                        タイトル候補を生成
                    </button>
                    @if (string.IsNullOrWhiteSpace(form.Keyword) && !isGeneratingTitles)
                    {
                        <div class="form-text">キーワードを入力すると使用できます</div>
                    }
                    else if (!string.IsNullOrWhiteSpace(titleGenerationError) && !showTitleCandidatesModal)
                    {
                        <div class="form-text text-danger">@titleGenerationError</div>
                    }
                    else if (isGeneratingTitles && !string.IsNullOrWhiteSpace(titleGenerationStatusText))
                    {
                        <div class="form-text">@titleGenerationStatusText</div>
                    }
                </div>
                <div class="col-lg-4">
                    <label class="form-label" for="title">タイトル <span class="text-muted small">任意</span></label>
                    <InputText id="title" class="form-control" @bind-Value="form.Title" />
                    <ValidationMessage For="() => form.Title" />
                    <div class="form-text">未入力の場合はキーワードを使います。</div>
                </div>
            </div>
        </section>

        <section class="article-panel mb-3">
            <button type="button" class="btn btn-link px-0" aria-expanded="@showDetails" @onclick="() => showDetails = !showDetails">
                詳細設定@(showDetails ? "を閉じる" : "を開く")
            </button>

            @if (showDetails)
            {
                <div class="row g-3 mt-1">
                    <fieldset class="col-12 create-settings-group"><legend class="h6">構成</legend><div class="row g-3">
                    <div class="col-md-2">
                        <label class="form-label" for="h2-count">H2の個数</label>
                        <InputNumber id="h2-count" class="form-control" min="1" max="20" @bind-Value="form.H2Count" />
                        <ValidationMessage For="() => form.H2Count" /><div class="form-text">大見出しを1〜20個</div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label" for="h3-count">H3の個数</label>
                        <InputNumber id="h3-count" class="form-control" min="0" max="60" @bind-Value="form.H3Count" />
                        <ValidationMessage For="() => form.H3Count" /><div class="form-text">小見出しを記事全体で0〜60個</div>
                    </div>
                    </div></fieldset>
                    <fieldset class="col-12 create-settings-group"><legend class="h6">文体・読者</legend><div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" for="tone">文章のトーン</label>
                        <InputSelect id="tone" class="form-select" @bind-Value="form.Tone">
                            <option value="Normal">通常</option>
                            <option value="Friendly">親しみやすい</option>
                            <option value="Professional">専門的</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <InputCheckbox id="is-domestic" class="form-check-input" @bind-Value="form.IsDomesticOnly" />
                            <label class="form-check-label" for="is-domestic">情報は日本国内のものに限定</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="writing-profile">サイト別ライティング設定</label>
                        <select id="writing-profile" class="form-select" @bind="form.WritingProfileWordpressSiteId">
                            <option value="">使用しない</option>
                            @foreach (var profile in formOptions.WritingProfiles)
                            {
                                <option value="@profile.Id">@profile.SiteName</option>
                            }
                        </select>
                    </div>
                    </div></fieldset>
                    <fieldset class="col-12 create-settings-group"><legend class="h6">参考資料</legend><div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="suggested">サジェストキーワード</label>
                        <InputTextArea id="suggested" class="form-control" rows="4" @bind-Value="form.SuggestedKeywords" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="related">関連キーワード</label>
                        <InputTextArea id="related" class="form-control" rows="4" @bind-Value="form.RelatedKeywords" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="learning-type">参考資料の種類</label>
                        <InputSelect id="learning-type" class="form-select" @bind-Value="form.LearningType">
                            <option value="None">なし</option>
                            <option value="Text">テキスト</option>
                            <option value="Url">URL</option>
                        </InputSelect>
                    </div>
                    @if (form.LearningType != "None")
                    {
                        <div class="col-md-8">
                            <label class="form-label" for="learning-text">参考資料</label>
                            <InputTextArea id="learning-text" class="form-control" rows="3" @bind-Value="form.LearningText" />
                            <div class="form-text">テキストは参考にしたい内容、URLはhttps://から始まる公開ページを入力してください。</div>
                        </div>
                    }
                    <div class="col-md-6">
                        <label class="form-label" for="additional-prompt">追加プロンプト</label>
                        <InputTextArea id="additional-prompt" class="form-control" rows="4" @bind-Value="form.AdditionalPrompt" />
                    </div>
                    </div></fieldset>
                    <fieldset class="col-12 create-settings-group"><legend class="h6">管理情報</legend><div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="tags">タグ</label>
                        <InputText id="tags" class="form-control" @bind-Value="form.Tags" />
                        <div class="form-text">例：コーヒー, 初心者（カンマ区切り）</div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="memo">メモ</label>
                        <InputText id="memo" class="form-control" @bind-Value="form.Memo" />
                    </div>
                    </div></fieldset>
                </div>
            }
        </section>

        <section class="article-panel mb-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label" for="outline-method">見出し構築方法</label>
                    <InputSelect id="outline-method" class="form-select" @bind-Value="form.OutlineMethod">
                        <option value="Keyword">キーワード</option>
                        <option value="Search">検索</option>
                        <option value="Ai">AI</option>
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="generation-model">生成モデル</label>
                    <InputSelect id="generation-model" class="form-select" @bind-Value="form.GenerationModel">
                        @foreach (var model in formOptions.GenerationModels)
                        {
                            <option value="@model.Model">@model.DisplayName</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <div class="form-check">
                        <InputCheckbox id="search-mode" class="form-check-input" @bind-Value="form.SearchMode" />
                        <label class="form-check-label" for="search-mode">検索モード</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="notification-mode">通知設定</label>
                    <InputSelect disabled="@ExecutionContext.IsGuest" id="notification-mode" class="form-select" @bind-Value="form.NotificationMode">
                        <option value="None">通知なし</option>
                        @if (!ExecutionContext.IsGuest)
                        {
                            <option value="Discord">Discord</option>
                        }
                    </InputSelect>
                </div>
            </div>
        </section>

        <p class="form-text">構築方法の「検索」は検索結果を参考に見出しを作成します。「検索モード」は本文生成でもWeb情報を参照します。@(ExecutionContext.IsGuest ? "ゲストの生成・検索はサンプルで、Discord通知は利用できません。" : "")</p>
        <div class="d-flex justify-content-end gap-2">
            <button type="submit" class="btn btn-primary" disabled="@(isSubmitting || isGeneratingTitles)">構成を作成</button>
        </div>
    </EditForm>

    @if (showTitleCandidatesModal)
    {
        <AppDialog Title="タイトル候補" OnClose="CloseTitleCandidatesModal" ReturnFocusId="generate-titles">
                <p class="text-muted small mb-3">生成モデル: @titleCandidatesModelLabel</p>

                @if (isGeneratingTitles)
                {
                    <div class="text-muted small mb-2">@titleGenerationStatusText</div>
                }

                <div class="article-title-candidate-list">
                    @foreach (var candidate in titleCandidates)
                    {
                        <label class="article-title-candidate">
                            <input type="radio" name="title-candidate" class="form-check-input"
                                   checked="@(selectedCandidateTitle == candidate.Title)"
                                   @onchange="() => selectedCandidateTitle = candidate.Title" />
                            <span>
                                <span class="article-title-candidate-text">@candidate.Title</span>
                                @if (!string.IsNullOrWhiteSpace(candidate.Reason))
                                {
                                    <span class="article-title-candidate-reason">@candidate.Reason</span>
                                }
                            </span>
                        </label>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(titleGenerationError))
                {
                    <div class="alert alert-danger mt-2" role="alert">@titleGenerationError</div>
                }

                <div class="d-flex justify-content-between align-items-center mt-3">
                    <button type="button" class="btn btn-outline-secondary" disabled="@isGeneratingTitles" @onclick="GenerateTitleCandidatesAsync">
                        @(isGeneratingTitles ? "再生成中…" : "再生成")
                    </button>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseTitleCandidatesModal">閉じる</button>
                        <button type="button" class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(selectedCandidateTitle))" @onclick="ApplySelectedTitleCandidate">選択して反映</button>
                    </div>
                </div>
        </AppDialog>
    }
</div>

@code {
    private static readonly JsonSerializerOptions JobPayloadJsonOptions = new(JsonSerializerDefaults.Web);

    private readonly ArticleCreateForm form = new();
    private readonly CancellationTokenSource cancellationTokenSource = new();
    private ArticleFormOptionsResponse formOptions = new([], []);
    private bool showDetails;
    private bool isSubmitting;
    private string? errorMessage;

    private Guid? draftArticleId;
    private bool isGeneratingTitles;
    private string? titleGenerationStatusText;
    private string? titleGenerationError;
    private bool showTitleCandidatesModal;
    private bool modalDismissedForCurrentGeneration;
    private IReadOnlyList<TitleCandidate> titleCandidates = [];
    private string? selectedCandidateTitle;
    private string? titleCandidatesModelLabel;

    private bool CanGenerateTitleCandidates =>
        !string.IsNullOrWhiteSpace(form.Keyword) && !isGeneratingTitles && !isSubmitting;

    // Captured synchronously (before any await) so a save and its related job payload always
    // agree, even if the user keeps editing the form while the save/generation is in flight.
    private ArticleFormSnapshot CaptureFormSnapshot()
    {
        return new ArticleFormSnapshot(
            form.Keyword,
            form.Title,
            form.H2Count,
            form.H3Count,
            form.Tone,
            form.IsDomesticOnly,
            form.Tags,
            form.Memo,
            form.SuggestedKeywords,
            form.RelatedKeywords,
            form.LearningType,
            form.LearningText,
            form.AdditionalPrompt,
            form.WritingProfileWordpressSiteId,
            form.OutlineMethod,
            form.GenerationModel,
            form.SearchMode,
            form.NotificationMode);
    }

    public void Dispose()
    {
        cancellationTokenSource.Cancel();
        cancellationTokenSource.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        using var scope = CreateOperationScope();
        var userId = await GetUserIdAsync();
        if (userId is null)
        {
            return;
        }

        formOptions = await scope.ServiceProvider.GetRequiredService<IArticleQueryService>().GetFormOptionsAsync(userId);
        form.GenerationModel = formOptions.GenerationModels.FirstOrDefault()?.Model ?? string.Empty;
    }

    private async Task CreateAsync()
    {
        using var scope = CreateOperationScope();
        if (isSubmitting || isGeneratingTitles)
        {
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        StateHasChanged();

        var snapshot = CaptureFormSnapshot();

        try
        {
            var actor = await GetArticleActorAsync();
            if (actor is null)
            {
                return;
            }

            Guid? articleId;
            if (draftArticleId.HasValue)
            {
                var (updatedId, updateError) = await UpdateDraftAsync(
                    actor,
                    draftArticleId.Value,
                    snapshot,
                    cancellationTokenSource.Token);
                errorMessage = updateError;
                articleId = updatedId;
            }
            else
            {
                articleId = await CreateDraftAsync(actor.UserId, snapshot);
            }

            if (articleId is null)
            {
                return;
            }

            // Keep the draft on enqueue failure so retrying does not create another article.
            draftArticleId = articleId;
            var payload = new OutlineGenerationPayload(articleId.Value, snapshot.Keyword, snapshot.Title,
                snapshot.H2Count, snapshot.H3Count, snapshot.OutlineMethod, snapshot.GenerationModel,
                snapshot.SearchMode, snapshot.IsDomesticOnly, snapshot.Tone, snapshot.SuggestedKeywords,
                snapshot.RelatedKeywords, snapshot.LearningType, snapshot.LearningText, snapshot.AdditionalPrompt);
            var queued = await scope.ServiceProvider.GetRequiredService<IJobCommandService>().EnqueueAsync(new EnqueueJobCommand(
                new JobActor(actor.UserId, actor.IsAdmin), JobType.OutlineGeneration, articleId.Value, null,
                JsonSerializer.Serialize(payload, JobPayloadJsonOptions), 0), cancellationTokenSource.Token);
            if (!queued.Succeeded || queued.Value is null)
            {
                errorMessage = "下書きは保存済みです。" + GetJobServiceErrorMessage(queued.Error, queued.ValidationErrors);
                return;
            }
            NavigationManager.NavigateTo($"/articles/{articleId}?job={queued.Value.JobId}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task<Guid?> CreateDraftAsync(string userId, ArticleFormSnapshot snapshot)
    {
        using var scope = CreateOperationScope();
        var result = await scope.ServiceProvider.GetRequiredService<IArticleCommandService>().CreateAsync(
            BuildCreateArticleCommand(userId, snapshot),
            cancellationTokenSource.Token);

        if (!result.Succeeded || result.Value is null)
        {
            errorMessage = GetServiceErrorMessage(result.Error, result.ValidationErrors);
            return null;
        }

        return result.Value.Id;
    }

    private async Task<(Guid? ArticleId, string? Error)> UpdateDraftAsync(
        ArticleActor actor,
        Guid articleId,
        ArticleFormSnapshot snapshot,
        CancellationToken cancellationToken = default)
    {
        using var scope = CreateOperationScope();
        var result = await scope.ServiceProvider.GetRequiredService<IArticleCommandService>().UpdateAsync(
            new UpdateArticleCommand(
                actor,
                articleId,
                snapshot.Keyword,
                string.IsNullOrWhiteSpace(snapshot.Title) ? snapshot.Keyword : snapshot.Title,
                ArticleInputNormalizer.SplitTags(snapshot.Tags),
                snapshot.Memo,
                snapshot.Tone,
                snapshot.SuggestedKeywords,
                snapshot.RelatedKeywords,
                snapshot.LearningType,
                snapshot.LearningText,
                snapshot.AdditionalPrompt,
                MetaDescription: null,
                snapshot.GenerationModel,
                snapshot.OutlineMethod,
                snapshot.SearchMode,
                snapshot.IsDomesticOnly,
                snapshot.NotificationMode,
                ParseGuid(snapshot.WritingProfileWordpressSiteId),
                Body: null,
                HtmlBody: null,
                RowVersion: null),
            cancellationToken);

        return result.Succeeded && result.Value is not null
            ? (articleId, null)
            : (null, GetServiceErrorMessage(result.Error, result.ValidationErrors));
    }

    private static CreateArticleCommand BuildCreateArticleCommand(string userId, ArticleFormSnapshot snapshot)
    {
        return new CreateArticleCommand(
            userId,
            snapshot.Keyword,
            snapshot.Title,
            GenerateImage: false,
            snapshot.H2Count,
            snapshot.H3Count,
            snapshot.Tone,
            ArticleInputNormalizer.SplitTags(snapshot.Tags),
            snapshot.Memo,
            snapshot.SuggestedKeywords,
            snapshot.RelatedKeywords,
            snapshot.LearningType,
            snapshot.LearningText,
            snapshot.AdditionalPrompt,
            ParseGuid(snapshot.WritingProfileWordpressSiteId),
            snapshot.OutlineMethod,
            snapshot.GenerationModel,
            snapshot.SearchMode,
            snapshot.IsDomesticOnly,
            snapshot.NotificationMode);
    }

    private async Task GenerateTitleCandidatesAsync()
    {
        using var scope = CreateOperationScope();
        if (!CanGenerateTitleCandidates)
        {
            return;
        }

        var cancellationToken = cancellationTokenSource.Token;

        // Captured once, up front: both the draft save below and the job payload built in
        // RunTitleGenerationAsync must agree, even if the user keeps typing while either await
        // is in flight (see the code review that flagged the article/job keyword mismatch).
        var snapshot = CaptureFormSnapshot();

        titleGenerationError = null;
        isGeneratingTitles = true;
        modalDismissedForCurrentGeneration = false;
        StateHasChanged();

        try
        {
            var jobActor = await GetJobActorAsync();
            if (jobActor is null)
            {
                titleGenerationError = "ログインが必要です。";
                return;
            }

            if (draftArticleId is null)
            {
                titleGenerationStatusText = "下書きを作成しています…";
                StateHasChanged();

                var createResult = await scope.ServiceProvider.GetRequiredService<IArticleCommandService>().CreateAsync(
                    BuildCreateArticleCommand(jobActor.UserId, snapshot),
                    cancellationToken);

                if (!createResult.Succeeded || createResult.Value is null)
                {
                    titleGenerationError = GetServiceErrorMessage(createResult.Error, createResult.ValidationErrors);
                    return;
                }

                draftArticleId = createResult.Value.Id;
            }
            else
            {
                // Re-sync the draft before regenerating: the keyword or other fields may have
                // changed since it was first saved, and the job handler reads its prompt context
                // (including topic risk / strict mode) from the saved article, not the job payload.
                titleGenerationStatusText = "下書きを更新しています…";
                StateHasChanged();

                var articleActor = new ArticleActor(jobActor.UserId, jobActor.IsAdmin);
                var (updatedArticleId, updateError) = await UpdateDraftAsync(
                    articleActor,
                    draftArticleId.Value,
                    snapshot,
                    cancellationToken);

                if (updatedArticleId is null)
                {
                    titleGenerationError = updateError ?? "下書きの更新に失敗しました。";
                    return;
                }
            }

            await RunTitleGenerationAsync(jobActor, draftArticleId.Value, snapshot, cancellationToken);
        }
        finally
        {
            isGeneratingTitles = false;
            titleGenerationStatusText = null;
        }
    }

    private async Task RunTitleGenerationAsync(
        JobActor actor,
        Guid articleId,
        ArticleFormSnapshot snapshot,
        CancellationToken cancellationToken)
    {
        using var scope = CreateOperationScope();
        titleGenerationStatusText = "タイトル候補を生成しています…";
        StateHasChanged();

        var payload = new TitleGenerationPayload(
            articleId,
            snapshot.Keyword,
            snapshot.GenerationModel,
            CandidateCount: null,
            TitleMethod: null,
            snapshot.SuggestedKeywords,
            snapshot.RelatedKeywords,
            snapshot.AdditionalPrompt);

        var enqueueResult = await scope.ServiceProvider.GetRequiredService<IJobCommandService>().EnqueueAsync(
            new EnqueueJobCommand(
                actor,
                JobType.TitleGeneration,
                articleId,
                HeadingId: null,
                JsonSerializer.Serialize(payload, JobPayloadJsonOptions),
                Priority: 0),
            cancellationToken);

        if (!enqueueResult.Succeeded || enqueueResult.Value is null)
        {
            titleGenerationError = GetJobServiceErrorMessage(enqueueResult.Error, enqueueResult.ValidationErrors);
            return;
        }

        titleCandidatesModelLabel = formOptions.GenerationModels
            .FirstOrDefault(model => model.Model == snapshot.GenerationModel)?.DisplayName
            ?? snapshot.GenerationModel;

        var jobId = enqueueResult.Value.JobId;
        var deadline = DateTimeOffset.UtcNow.AddSeconds(150);

        while (DateTimeOffset.UtcNow < deadline)
        {
            await Task.Delay(TimeSpan.FromSeconds(2), cancellationToken);

            var status = await scope.ServiceProvider.GetRequiredService<IJobQueryService>().GetAsync(actor, jobId, cancellationToken);
            if (status is null)
            {
                titleGenerationError = "ジョブの状態を取得できませんでした。";
                return;
            }

            if (status.Status == "Succeeded")
            {
                var candidates = ParseCandidates(status.Result);
                if (candidates.Count == 0)
                {
                    titleGenerationError = "タイトル候補を取得できませんでした。時間をおいて再実行してください。";
                    return;
                }

                titleCandidates = candidates;
                selectedCandidateTitle = candidates[0].Title;
                showTitleCandidatesModal = !modalDismissedForCurrentGeneration;
                return;
            }

            if (status.Status is "Failed" or "Canceled")
            {
                titleGenerationError = status.Status == "Canceled"
                    ? "タイトル候補の生成がキャンセルされました。"
                    : GetJobFailureMessage(status.ErrorMessage);
                return;
            }

            titleGenerationStatusText = $"タイトル候補を生成しています…（{GetJobStatusLabel(status.Status)}）";
            StateHasChanged();
        }

        titleGenerationError = "タイトル候補の生成がタイムアウトしました。時間をおいて再実行してください。";
    }

    private static IReadOnlyList<TitleCandidate> ParseCandidates(object? result)
    {
        if (result is not JsonElement element
            || element.ValueKind != JsonValueKind.Object
            || !element.TryGetProperty("candidates", out var candidatesElement)
            || candidatesElement.ValueKind != JsonValueKind.Array)
        {
            return [];
        }

        var list = new List<TitleCandidate>();
        foreach (var item in candidatesElement.EnumerateArray())
        {
            var title = item.TryGetProperty("title", out var titleProperty) && titleProperty.ValueKind == JsonValueKind.String
                ? titleProperty.GetString()?.Trim()
                : null;

            if (string.IsNullOrWhiteSpace(title))
            {
                continue;
            }

            var reason = item.TryGetProperty("reason", out var reasonProperty) && reasonProperty.ValueKind == JsonValueKind.String
                ? reasonProperty.GetString()?.Trim()
                : null;

            list.Add(new TitleCandidate(title, reason));
        }

        return list;
    }

    private void ApplySelectedTitleCandidate()
    {
        if (string.IsNullOrWhiteSpace(selectedCandidateTitle))
        {
            return;
        }

        form.Title = selectedCandidateTitle;
        CloseTitleCandidatesModal();
    }

    private void CloseTitleCandidatesModal()
    {
        showTitleCandidatesModal = false;
        if (isGeneratingTitles)
        {
            modalDismissedForCurrentGeneration = true;
        }
    }

    private async Task<string?> GetUserIdAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        return authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }

    private async Task<ArticleActor?> GetArticleActorAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        return string.IsNullOrWhiteSpace(userId) ? null : new ArticleActor(userId, user.IsInRole("Admin"));
    }

    private async Task<JobActor?> GetJobActorAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        return string.IsNullOrWhiteSpace(userId) ? null : new JobActor(userId, user.IsInRole("Admin"));
    }

    private static Guid? ParseGuid(string? value)
    {
        return Guid.TryParse(value, out var guid) ? guid : null;
    }

    private static string GetServiceErrorMessage(
        ArticleServiceError error,
        IReadOnlyList<ArticleValidationError> validationErrors)
    {
        if (validationErrors.Count > 0)
        {
            return string.Join(" ", validationErrors.Select(item => item.Message));
        }

        return error == ArticleServiceError.NotFound
            ? "選択したサイト別ライティング設定が見つかりません。"
            : "記事を作成できませんでした。";
    }

    private static string GetJobServiceErrorMessage(
        JobServiceError error,
        IReadOnlyList<JobValidationError> validationErrors)
    {
        if (validationErrors.Count > 0)
        {
            return string.Join(" ", validationErrors.Select(item => item.Message));
        }

        return error switch
        {
            JobServiceError.NotFound => "対象のデータが見つかりません。",
            JobServiceError.RunningJobExists => "対象の処理が実行中です。完了後に再度操作してください。",
            JobServiceError.RateLimited => "リクエストが集中しています。時間をおいて再実行してください。",
            _ => "生成を開始できませんでした。"
        };
    }

    private static string GetJobFailureMessage(string? errorMessage)
    {
        return string.IsNullOrWhiteSpace(errorMessage)
            ? "タイトル候補の生成に失敗しました。時間をおいて再実行してください。"
            : errorMessage;
    }

    private static string GetJobStatusLabel(string status)
    {
        return status switch
        {
            "Queued" => "生成待ち",
            "Running" => "生成中",
            _ => status
        };
    }

    private IServiceScope CreateOperationScope()
    {
        var scope = ScopeFactory.CreateScope();
        if (ExecutionContext.IsGuest)
            scope.ServiceProvider.GetRequiredService<WebWritingTool.Application.Security.ExternalApiExecutionContext>().EnableGuestMode();
        return scope;
    }

    private sealed record ArticleFormSnapshot(
        string Keyword,
        string? Title,
        int? H2Count,
        int? H3Count,
        string? Tone,
        bool IsDomesticOnly,
        string? Tags,
        string? Memo,
        string? SuggestedKeywords,
        string? RelatedKeywords,
        string? LearningType,
        string? LearningText,
        string? AdditionalPrompt,
        string? WritingProfileWordpressSiteId,
        string OutlineMethod,
        string GenerationModel,
        bool SearchMode,
        string? NotificationMode);

    private sealed class ArticleCreateForm
    {
        [Required(ErrorMessage = "キーワードを入力してください。")]
        [StringLength(200, ErrorMessage = "キーワードは200文字以内で入力してください。")]
        public string Keyword { get; set; } = string.Empty;

        [StringLength(250, ErrorMessage = "タイトルは250文字以内で入力してください。")]
        public string? Title { get; set; }

        [Range(1, 20, ErrorMessage = "H2は1〜20個で指定してください。") ]
        public int? H2Count { get; set; } = 5;

        [Range(0, 60, ErrorMessage = "H3は0〜60個で指定してください。") ]
        public int? H3Count { get; set; } = 12;

        public string? Tone { get; set; } = "Normal";

        public bool IsDomesticOnly { get; set; } = true;

        public string? Tags { get; set; }

        public string? Memo { get; set; }

        public string? SuggestedKeywords { get; set; }

        public string? RelatedKeywords { get; set; }

        public string? LearningType { get; set; } = "None";

        public string? LearningText { get; set; }

        public string? AdditionalPrompt { get; set; }

        public string? WritingProfileWordpressSiteId { get; set; }

        public string OutlineMethod { get; set; } = "Search";

        public string GenerationModel { get; set; } = string.Empty;

        public bool SearchMode { get; set; } = true;

        public string? NotificationMode { get; set; } = "None";
    }
}
