@page "/articles"
@inject WebWritingTool.Application.Security.ExternalApiExecutionContext ExecutionContext
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable

@using System.Security.Claims
@using WebWritingTool.Web.Components.Articles

@inject IArticleQueryService ArticleQueryService
@inject IArticleCommandService ArticleCommandService
@inject IArticleReviewService ArticleReviewService
@inject IWordpressPostCommandService WordpressPostCommandService
@inject IWordpressPostQueryService WordpressPostQueryService
@inject IWordpressSiteQueryService WordpressSiteQueryService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ILogger<Articles> Logger
@inject IServiceScopeFactory ScopeFactory

<PageTitle>記事一覧</PageTitle>

<div class="article-page">
    <header class="article-page-header">
        <div>
            <h1>記事一覧</h1>
        </div>
        <div class="article-actions">
            <a class="btn btn-primary" href="articles/create">記事を作成</a>
            <button class="btn btn-outline-secondary" type="button" @onclick="ToggleBulkForm">一括作成</button>
            <span class="article-disabled-action">
                <button class="btn btn-outline-secondary" type="button" disabled title="準備中の機能です。今後のフェーズで提供予定です。">記事インポート</button>
                <span class="article-disabled-hint">準備中</span>
            </span>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    @if (showBulkForm)
    {
        <section class="article-panel bulk-form mb-4">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                <h2 class="h5 mb-0">一括作成</h2>
                <button type="button" class="btn-close" aria-label="閉じる" @onclick="ToggleBulkForm"></button>
            </div>
            <label class="form-label" for="bulk-lines">キーワード一覧</label>
            <textarea id="bulk-lines" class="form-control" rows="5" placeholder="@BulkLinesPlaceholder" @bind="bulkLines" @bind:event="oninput" aria-invalid="@BulkInvalid("bulk-lines")" aria-describedby="bulk-lines-help bulk-lines-error"></textarea>
            <p id="bulk-lines-help" class="form-text">1行に1件。「キーワード|タイトル」でタイトルも指定できます。未入力のタイトルは自動生成します。</p>
            <BulkFieldError FieldId="bulk-lines" Message="@BulkError("bulk-lines")" />

            <div class="bulk-settings-group">
                <label class="form-label" for="bulk-generation-scope">生成する内容</label>
                <select id="bulk-generation-scope" class="form-select" @bind="bulkGenerationScope" aria-invalid="@BulkInvalid("bulk-generation-scope")" aria-describedby="bulk-generation-scope-error">
                    <option value="FullArticle">記事全体を生成（本文・HTMLまで）</option>
                    <option value="OutlineOnly">構成のみ生成</option>
                </select>
                <BulkFieldError FieldId="bulk-generation-scope" Message="@BulkError("bulk-generation-scope")" />
                <details id="bulk-outline-settings" class="mt-2">
                    <summary>記事の構成と生成設定</summary>
                    <p id="bulk-heading-help" class="form-text">H3は記事全体の合計です。見出し数は目安のため、生成結果によって多少前後します。</p>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label" for="bulk-h2">大見出し（H2）の目安</label>
                            <input id="bulk-h2" class="form-control" type="number" min="1" max="20" @bind="bulkH2Count" aria-invalid="@BulkInvalid("bulk-h2")" aria-describedby="bulk-h2-error bulk-heading-help" />
                            <BulkFieldError FieldId="bulk-h2" Message="@BulkError("bulk-h2")" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="bulk-h3">小見出し（H3）の目安・合計</label>
                            <input id="bulk-h3" class="form-control" type="number" min="0" max="60" @bind="bulkH3Count" aria-invalid="@BulkInvalid("bulk-h3")" aria-describedby="bulk-h3-error bulk-heading-help" />
                            <BulkFieldError FieldId="bulk-h3" Message="@BulkError("bulk-h3")" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="bulk-model">生成モデル</label>
                            <select id="bulk-model" class="form-select" @bind="bulkGenerationModel" aria-invalid="@BulkInvalid("bulk-model")" aria-describedby="bulk-model-error">
                                @foreach (var model in formOptions.GenerationModels)
                                { <option value="@model.Model">@model.DisplayName</option> }
                            </select>
                            <BulkFieldError FieldId="bulk-model" Message="@BulkError("bulk-model")" />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label" for="bulk-writing-profile">サイト別ライティング設定</label>
                            <select id="bulk-writing-profile" class="form-select" @bind="bulkWritingProfileId">
                                <option value="">使用しない</option>
                                @foreach (var profile in formOptions.WritingProfiles)
                                { <option value="@profile.Id">@profile.SiteName</option> }
                            </select>
                        </div>
                    </div>
                </details>
            </div>

            <fieldset class="bulk-settings-group">
                <legend class="h6">参考情報の検索</legend>
                <p class="form-text">選択した検索資料をタイトル・構成・本文で共有します。</p>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-check"><input id="bulk-search" class="form-check-input" type="checkbox" @bind="bulkSearchMode" /> Web検索を利用する</label>
                        <details id="bulk-web-settings" class="mt-1"><summary>Web検索の条件</summary>
                            <label class="form-label" for="bulk-web-count">Web検索件数</label>
                            <input id="bulk-web-count" class="form-control" type="number" min="1" max="20" disabled="@(!bulkSearchMode)" @bind="bulkWebCount" aria-invalid="@BulkInvalid("bulk-web-count")" aria-describedby="bulk-web-count-error" />
                            <BulkFieldError FieldId="bulk-web-count" Message="@BulkError("bulk-web-count")" />
                            <label class="form-check mt-2"><input id="bulk-domestic" class="form-check-input" type="checkbox" disabled="@(!bulkSearchMode)" @bind="bulkIsDomesticOnly" /> 国内情報に限定する</label>
                        </details>
                    </div>
                    <div class="col-md-6">
                        <label class="form-check"><input id="bulk-x-search" class="form-check-input" type="checkbox" @bind="bulkXSearch" /> X検索を利用する</label>
                        <details id="bulk-x-settings" class="mt-1"><summary>X検索の条件</summary>
                            <label class="form-label" for="bulk-x-count">X検索件数</label>
                            <input id="bulk-x-count" class="form-control" type="number" min="1" max="100" disabled="@(!bulkXSearch)" @bind="bulkXCount" aria-invalid="@BulkInvalid("bulk-x-count")" aria-describedby="bulk-x-count-error" />
                            <BulkFieldError FieldId="bulk-x-count" Message="@BulkError("bulk-x-count")" />
                            <label class="form-label mt-2" for="bulk-x-days">X検索期間（過去の日数）</label>
                            <input id="bulk-x-days" class="form-control" type="number" min="1" max="365" disabled="@(!bulkXSearch)" @bind="bulkXDays" aria-invalid="@BulkInvalid("bulk-x-days")" aria-describedby="bulk-x-days-error" />
                            <BulkFieldError FieldId="bulk-x-days" Message="@BulkError("bulk-x-days")" />
                        </details>
                    </div>
                </div>
            </fieldset>

            <details id="bulk-post-settings" class="bulk-settings-group"><summary>投稿先（任意）</summary>
                <label class="form-check"><input id="bulk-auto-post" class="form-check-input" type="checkbox" @bind="bulkAutoPostToWordpress" disabled="@ExecutionContext.IsGuest" /> WordPressへ下書きとして自動投稿する</label>
                @if (ExecutionContext.IsGuest) { <p class="form-text">ゲストはWordPress自動投稿を利用できません。</p> }
                @if (bulkAutoPostToWordpress && !ExecutionContext.IsGuest)
                {
                    <label class="form-label" for="bulk-auto-post-site">自動投稿先サイト</label>
                    <select id="bulk-auto-post-site" class="form-select" @bind="bulkAutoPostSiteId" aria-invalid="@BulkInvalid("bulk-auto-post-site")" aria-describedby="bulk-auto-post-site-error">
                        <option value="">未選択</option>
                        @foreach (var profile in formOptions.WritingProfiles)
                        { <option value="@profile.Id">@profile.SiteName</option> }
                    </select>
                    <BulkFieldError FieldId="bulk-auto-post-site" Message="@BulkError("bulk-auto-post-site")" />
                    <label class="form-label mt-2" for="bulk-category">自動投稿カテゴリ</label>
                    <input id="bulk-category" class="form-control" type="number" @bind="bulkAutoPostCategoryId" />
                    @if (bulkGenerationScope == "OutlineOnly") { <p class="form-text">構成のみ生成する場合、自動投稿は後で本文を生成し、HTMLが保存された時点で行います。</p> }
                }
            </details>
            @if (bulkRejectedLines.Count > 0)
            {
                <div class="alert alert-warning mt-3" role="alert">
                    @foreach (var rejectedLine in bulkRejectedLines)
                    {
                        @if (rejectedLine.LineNumber > 0) { <div>@rejectedLine.LineNumber 行目: @rejectedLine.Reason</div> }
                        else { <div>@rejectedLine.Reason</div> }
                    }
                </div>
                @if (successMessage is not null)
                { <p class="form-text">登録済みの行を除き、未登録の行だけを残しました。エラーの行番号は登録前の入力位置です。</p> }
            }
            <div class="bulk-start">
                <div><strong>作成する内容</strong><p class="small mb-0" data-testid="bulk-settings-summary">@BulkSummary</p></div>
                <button id="bulk-submit" type="button" class="btn btn-primary" @onclick="SubmitBulkAsync" disabled="@(isBulkSubmitting || string.IsNullOrWhiteSpace(bulkLines))">@(isBulkSubmitting ? "登録中…" : $"{BulkLineCount}件の記事を作成")</button>
            </div>
        </section>
    }
    <BulkGenerationPanel @ref="bulkProgressPanel" BatchId="activeBatchId" OnProgressChanged="RefreshGenerationAsync" />

    <section class="article-panel mb-3 article-search-disclosure">
        <button type="button" class="btn btn-link search-toggle" aria-expanded="@showSearch" @onclick="() => showSearch = !showSearch">記事を検索・絞り込み</button>
        <div class="row g-3 align-items-end search-fields @(showSearch ? "expanded" : "")">
            <div class="col-md-3">
                <label class="form-label" for="search-tags">タグ</label>
                <input id="search-tags" class="form-control" @bind="searchTags" />
            </div>
            <div class="col-md-5">
                <label class="form-label" for="search-q">キーワード検索</label>
                <input id="search-q" class="form-control" @bind="searchQuery" />
            </div>
            <div class="col-md-2">
                <label class="form-label" for="page-size">表示件数</label>
                <select id="page-size" class="form-select" @bind="pageSize">
                    <option value="10">10件</option>
                    <option value="30">30件</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-outline-primary w-100" @onclick="SearchAsync">検索</button>
            </div>
        </div>
    </section>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="text-muted">@articleList.TotalCount 件</div>
        @if (isLoading)
        {
            <div class="text-muted">読み込み中</div>
        }
    </div>

    @if (ExecutionContext.IsGuest) { <p class="small text-muted">ゲストではWordPress投稿を利用できません。</p> }
    <div class="table-responsive article-table-wrap">
        <table class="table table-sm align-middle article-table">
            <thead>
                <tr>
                    <th class="article-col-compact">作成日</th>
                    <th class="article-col-compact">見出し取得</th>
                    <th class="article-col-compact">ステータス</th>
                    <th>記事タイトル</th>
                    <th class="article-col-tags">タグ</th>
                    <th class="article-col-memo">メモ</th>
                    <th class="article-col-actions text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (articleList.Items.Count == 0 && !isLoading)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <div>@(HasActiveSearchFilter ? "検索条件に一致する記事がありません" : "最初の記事を作成しましょう")</div>
                            @if (!HasActiveSearchFilter) { <p class="small mt-2">キーワードを入力すると、見出し構成から本文まで作成できます。</p><a href="/articles/create" class="btn btn-primary">最初の記事を作成</a> }
                            @if (HasActiveSearchFilter)
                            {
                                <button type="button" class="btn btn-link btn-sm" @onclick="ClearSearchAsync">検索条件をクリア</button>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var article in articleList.Items)
                    {
                        <tr>
                            <td class="article-col-compact" data-label="作成日">@ToDisplayDate(article.CreatedAt)</td>
                            <td class="article-col-compact" data-label="見出し取得"><span class="badge text-bg-light">@GetHeadlineSourceLabel(article.HeadlineSource)</span></td>
                            <td class="article-col-compact" data-label="ステータス"><span class="badge @GetStatusBadgeClass(article.Status)">@(article.AutomaticGenerationStatus == "Canceled" ? "自動生成を停止中" : article.StatusLabel)</span></td>
                            <td data-label="記事タイトル">
                                <a href="@($"articles/{article.Id}")" class="fw-semibold">@GetArticleTitle(article)</a>
                            </td>
                            <td class="article-tags-cell" data-label="タグ">
                                @if (article.Tags.Count == 0) { <span class="text-muted">—</span> }
                                @foreach (var tag in article.Tags)
                                {
                                    <span class="badge text-bg-secondary">@tag</span>
                                }
                            </td>
                            <td class="article-memo-cell" title="@article.Memo" data-label="メモ">@(string.IsNullOrWhiteSpace(article.Memo) ? "—" : article.Memo)</td>
                            <td class="article-col-actions" data-label="操作">
                                <div class="d-flex justify-content-end gap-2">
                                    <a class="btn btn-sm btn-outline-primary" href="@($"articles/{article.Id}")">表示</a>
                                    @if (article.AutomaticGenerationStatus is "Canceled" or "Failed")
                                    { <button class="btn btn-sm btn-outline-primary bulk-resume" disabled="@resumingArticle" @onclick="() => ResumeArticleAsync(article.Id)">再開</button> }
                                    <button id="@($"post-{article.Id}")" class="btn btn-sm btn-outline-success" type="button" disabled="@(!article.CanPostToWordpress || ExecutionContext.IsGuest)" title="@(ExecutionContext.IsGuest ? "ゲストはWordPressへ投稿できません" : "WordPressへ投稿")" @onclick="() => OpenPostDialogAsync(article)">投稿</button>
                                    <button class="btn btn-sm btn-outline-danger" type="button" disabled="@article.HasRunningJob" @onclick="() => ConfirmDelete(article)">削除</button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (articleList.TotalPages > 1)
    {
        <div class="d-flex justify-content-between align-items-center mt-3">
            <button type="button" class="btn btn-outline-secondary" disabled="@(!articleList.HasPrevious)" @onclick="() => GoToPage(articleList.Page - 1)">前へ</button>
            <span>@articleList.Page / @Math.Max(articleList.TotalPages, 1)</span>
            <button type="button" class="btn btn-outline-secondary" disabled="@(!articleList.HasNext)" @onclick="() => GoToPage(articleList.Page + 1)">次へ</button>
        </div>
    }

    @if (deleteTarget is not null)
    {
        <div class="article-dialog-backdrop">
            <section class="article-dialog" role="dialog" aria-modal="true" @ref="deleteDialogRef">
                <h2 class="h5">記事を削除</h2>
                <p class="mb-2">@GetArticleTitle(deleteTarget)</p>
                <p>この記事と配下の見出し・本文を一覧から削除します。画面から元には戻せません。</p>
                @if (deleteTarget.HasQueuedJob)
                {
                    <p class="text-muted">待機中ジョブは削除時にキャンセルされます。</p>
                }
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" @ref="deleteCancelButtonRef" @onclick="CancelDelete">キャンセル</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteAsync">削除</button>
                </div>
            </section>
        </div>
    }

    @if (postTarget is not null)
    {
        <AppDialog Title="WordPress投稿" OnClose="ClosePostDialog" ReturnFocusId="@($"post-{postTarget.Id}")">
                @if (isPostDialogLoading)
                {
                    <div class="text-muted">読み込み中</div>
                }
                else if (postPreview is null)
                {
                    <div class="alert alert-warning">投稿プレビューを取得できませんでした。</div>
                }
                else if (postPreview.AvailableSites.Count == 0)
                {
                    <div class="alert alert-warning">WordPressサイトが登録されていません。<a href="/settings">設定</a>から登録してください。</div>
                }
                else
                {
                    <div class="mb-3">
                        <label class="form-label" for="post-title">タイトル</label>
                        <input id="post-title" class="form-control" @bind="postForm.Title" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="post-site">投稿先サイト</label>
                        <select id="post-site" class="form-select" value="@postForm.SiteId" @onchange="OnPostSiteChangedAsync">
                            @foreach (var site in postPreview.AvailableSites)
                            {
                                <option value="@site.Id">@site.SiteName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="post-category">カテゴリ</label>
                        <select id="post-category" class="form-select" value="@postForm.CategoryId" @onchange="OnPostCategoryChanged">
                            <option value="">既定カテゴリ</option>
                            @foreach (var category in postCategories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                        @if (!string.IsNullOrWhiteSpace(postCategoriesError) && postCategoriesUnauthorized)
                        {
                            <div class="form-text text-danger">カテゴリ一覧を取得できませんでした。@postCategoriesError 認証または権限の問題があります。<a href="/settings">設定</a>でサイトの登録情報と権限を確認してください。</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(postCategoriesError))
                        {
                            <div class="form-text text-danger">カテゴリ一覧を取得できませんでした。@postCategoriesError 既定カテゴリで投稿できます。</div>
                        }
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="post-status">投稿ステータス</label>
                        <select id="post-status" class="form-select" @bind="postForm.Status">
                            <option value="@WordpressPostStatuses.Draft">下書き</option>
                            <option value="@WordpressPostStatuses.Publish" disabled="@IsPublishBlocked">公開</option>
                        </select>
                    </div>
                    @if (IsPublishBlocked)
                    {
                        <div class="alert alert-warning d-flex justify-content-between align-items-center gap-2">
                            <span>人間確認前の記事は公開投稿できません。下書き投稿は可能です。</span>
                            <button type="button" class="btn btn-sm btn-outline-primary" disabled="@isReviewSubmitting" @onclick="CompleteHumanReviewAsync">人間確認を完了</button>
                        </div>
                    }
                    <div class="mb-3">
                        <label class="form-label" for="post-html">本文HTML</label>
                        <textarea id="post-html" class="form-control" rows="8" @bind="postForm.HtmlBody"></textarea>
                    </div>
                }
                <div class="d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="ClosePostDialog">閉じる</button>
                    <button type="button" class="btn btn-success" disabled="@(!CanSubmitPost)" @onclick="SubmitPostAsync">投稿ジョブ登録</button>
                </div>
        </AppDialog>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public int? QueryPage { get; set; }

    [SupplyParameterFromQuery(Name = "pageSize")]
    public int? QueryPageSize { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? QuerySearch { get; set; }

    [SupplyParameterFromQuery(Name = "tags")]
    public string? QueryTags { get; set; }

    private ArticleListResponse articleList = new([], 1, 10, 0, 0, false, false);
    private ArticleFormOptionsResponse formOptions = new([], []);
    private string? searchQuery;
    private string? searchTags;
    private int pageSize = 10;
    private bool isLoading;
    private bool optionsLoaded;
    private string? errorMessage;
    private string? successMessage;
    private bool showBulkForm;
    private const string BulkLinesPlaceholder =
        "1行に1件。「キーワード」または「キーワード|タイトル」の形式で入力してください。\n例: Blazor SEO\n例: WordPress REST API|投稿連携の記事";
    private bool showSearch;
    private string? bulkLines;
    private int? bulkH2Count = 5;
    private int? bulkH3Count = 12;
    private bool bulkIsDomesticOnly = true;
    private string bulkGenerationScope = "FullArticle";
    private bool bulkXSearch;
    private int bulkWebCount = 10;
    private int bulkXCount = 10;
    private int bulkXDays = 30;
    private Guid? activeBatchId;
    private BulkGenerationPanel? bulkProgressPanel;
    private bool resumingArticle;
    private readonly Dictionary<string, string> bulkFieldErrors = new(StringComparer.OrdinalIgnoreCase);
    private string? pendingBulkFocus;
    private string? BulkError(string id) => bulkFieldErrors.GetValueOrDefault(id);
    private string? BulkInvalid(string id) => bulkFieldErrors.ContainsKey(id) ? "true" : null;
    private int BulkLineCount => (bulkLines ?? string.Empty).Split('\n').Count(line => !string.IsNullOrWhiteSpace(line));
    private string BulkSummary => $"{BulkLineCount}記事 · {(bulkGenerationScope == "FullArticle" ? "本文・HTMLまで" : "構成のみ")} · "
        + $"H2目安 {bulkH2Count ?? 5} / H3合計目安 {bulkH3Count ?? 12} · "
        + (bulkSearchMode ? $"Web {bulkWebCount}件{(bulkIsDomesticOnly ? "（国内）" : "")}" : "Webなし") + " · "
        + (bulkXSearch ? $"X {bulkXCount}件（過去{bulkXDays}日）" : "Xなし") + " · "
        + (bulkAutoPostToWordpress ? "WordPress下書き投稿あり" : "投稿なし");
    private string bulkGenerationModel = string.Empty;
    private bool bulkSearchMode = true;
    private string? bulkWritingProfileId;
    private bool bulkAutoPostToWordpress;
    private string? bulkAutoPostSiteId;
    private int? bulkAutoPostCategoryId;
    private bool isBulkSubmitting;
    private IReadOnlyList<BulkArticleRejectedLine> bulkRejectedLines = [];
    private ArticleListItemResponse? deleteTarget;
    private ElementReference deleteDialogRef;
    private ElementReference deleteCancelButtonRef;
    private IJSObjectReference? dialogFocusModule;
    private Task<IJSObjectReference>? dialogFocusModuleImport;
    private DotNetObjectReference<Articles>? dialogFocusDotNetRef;
    private bool deleteDialogFocusActive;
    private int deleteDialogGeneration;
    private bool disposed;
    private ArticleListItemResponse? postTarget;
    private WordpressPostPreviewResponse? postPreview;
    private IReadOnlyList<WordpressCategoryDto> postCategories = [];
    private string? postCategoriesError;
    private bool postCategoriesUnauthorized;
    private readonly WordpressPostForm postForm = new();
    private bool isPostDialogLoading;
    private bool isPostSubmitting;
    private bool isReviewSubmitting;

    private bool IsPublishBlocked => postPreview?.HumanReviewRequired == true && postPreview.HumanReviewedAt is null;

    private bool CanSubmitPost =>
        !isPostSubmitting
        && postPreview is not null
        && postPreview.AvailableSites.Count > 0
        && Guid.TryParse(postForm.SiteId, out _)
        && !string.IsNullOrWhiteSpace(postForm.Title)
        && !string.IsNullOrWhiteSpace(postForm.HtmlBody)
        && !(IsPublishBlocked && postForm.Status == WordpressPostStatuses.Publish);

    protected override async Task OnParametersSetAsync()
    {
        searchQuery = QuerySearch;
        searchTags = QueryTags;
        pageSize = QueryPageSize is 30 ? 30 : 10;
        await EnsureOptionsAsync();
        await LoadArticlesAsync(QueryPage ?? 1);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingBulkFocus is { } fieldId)
        {
            pendingBulkFocus = null;
            await using var module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/appDialog.js");
            await module.InvokeVoidAsync("focusInvalidField", fieldId);
        }
        if (deleteTarget is not null && !deleteDialogFocusActive)
        {
            // Captured so a stale invocation can tell it has been superseded by a newer one (see
            // below) instead of relying on deleteTarget alone, which a cancel-then-reopen can make
            // non-null again before this invocation resumes (delete-focus-followup-2026-09-17 review).
            var generation = ++deleteDialogGeneration;

            // Shared so concurrent invocations (a cancel-then-reopen while this is in flight) await
            // the same import instead of each starting their own: two separate JSRuntime.InvokeAsync
            // calls would each hand back a distinct IJSObjectReference, and plain "dialogFocusModule
            // ??= ..." only keeps whichever one is assigned last, leaking the other
            // (delete-focus-followup-2026-09-18 review, second follow-up).
            dialogFocusModuleImport ??= JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/dialogFocus.js").AsTask();
            dialogFocusModule = await dialogFocusModuleImport;

            if (disposed)
            {
                // DisposeAsync can run while the import above is still awaited. dialogFocusModule
                // was null when it ran, so it never got a reference to release -- release the one
                // just received here instead of leaking it for the rest of the circuit's lifetime
                // (delete-focus-followup-2026-09-18 review).
                await DisposeDialogFocusModuleAsync();
                return;
            }

            // CancelDelete() or a cancel-then-reopen can run while the import above is awaited. A
            // superseded generation means a newer invocation now owns the dialog's lifecycle --
            // either way this invocation must stop here without touching JS state
            // (precommit-review-2026-09-17 review).
            if (generation != deleteDialogGeneration || deleteTarget is null)
            {
                return;
            }

            dialogFocusDotNetRef ??= DotNetObjectReference.Create(this);
            await dialogFocusModule.InvokeVoidAsync(
                "open",
                deleteDialogRef,
                deleteCancelButtonRef,
                dialogFocusDotNetRef);

            if (disposed)
            {
                // dialogFocusModule may already be disposed by the time this resumes; calling
                // "close" on it would throw ObjectDisposedException instead of cleaning up.
                return;
            }

            if (generation != deleteDialogGeneration)
            {
                // A newer open attempt has already taken over (or is about to) by now -- calling
                // close() here would tear down its listener instead of this stale attempt's own
                // (delete-focus-followup-2026-09-18 review). Only the current generation's own
                // cancel path below is responsible for cleanup.
                return;
            }

            if (deleteTarget is null)
            {
                await dialogFocusModule.InvokeVoidAsync("close");
                return;
            }

            deleteDialogFocusActive = true;
        }
        else if (deleteTarget is null && deleteDialogFocusActive)
        {
            deleteDialogFocusActive = false;
            if (dialogFocusModule is not null && !disposed)
            {
                await dialogFocusModule.InvokeVoidAsync("close");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        dialogFocusDotNetRef?.Dispose();
        await DisposeDialogFocusModuleAsync();
    }

    private async Task DisposeDialogFocusModuleAsync()
    {
        if (dialogFocusModule is null)
        {
            return;
        }

        try
        {
            await dialogFocusModule.DisposeAsync();
        }
        catch (JSDisconnectedException exception)
        {
            Logger.LogDebug(
                exception,
                "Skipped dialogFocus.js cleanup because the circuit disconnected before disposal ran.");
        }
    }

    private async Task EnsureOptionsAsync()
    {
        if (optionsLoaded)
        {
            return;
        }

        var actor = await GetActorAsync();
        if (actor is null)
        {
            return;
        }

        formOptions = await ArticleQueryService.GetFormOptionsAsync(actor.UserId);
        bulkGenerationModel = formOptions.GenerationModels.FirstOrDefault()?.Model ?? string.Empty;
        optionsLoaded = true;
    }

    private async Task LoadArticlesAsync(int page)
    {
        var actor = await GetActorAsync();
        if (actor is null)
        {
            return;
        }

        isLoading = true;
        errorMessage = null;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            articleList = await scope.ServiceProvider.GetRequiredService<IArticleQueryService>().SearchAsync(
                actor,
                new ArticleListQuery(
                    page,
                    pageSize,
                    searchQuery,
                    ArticleInputNormalizer.SplitTags(searchTags),
                    Status: null,
                    CreatedFrom: null,
                    CreatedTo: null,
                    Sort: "createdAt",
                    Direction: "desc"));
        }
        catch (Exception)
        {
            errorMessage = "記事一覧を取得できませんでした。";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool HasActiveSearchFilter =>
        !string.IsNullOrWhiteSpace(searchQuery) || !string.IsNullOrWhiteSpace(searchTags);

    private async Task RefreshGenerationAsync()
    {
        if (!disposed && !isLoading && !isBulkSubmitting) await LoadArticlesAsync(articleList.Page);
    }

    private Task SearchAsync()
    {
        NavigationManager.NavigateTo(BuildListUrl(1));
        return Task.CompletedTask;
    }

    private Task ClearSearchAsync()
    {
        searchQuery = null;
        searchTags = null;
        NavigationManager.NavigateTo("/articles");
        return Task.CompletedTask;
    }

    private void GoToPage(int page)
    {
        NavigationManager.NavigateTo(BuildListUrl(page));
    }

    private string BuildListUrl(int page)
    {
        var query = new List<string>
        {
            $"page={page}",
            $"pageSize={pageSize}"
        };

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            query.Add($"q={Uri.EscapeDataString(searchQuery)}");
        }

        if (!string.IsNullOrWhiteSpace(searchTags))
        {
            query.Add($"tags={Uri.EscapeDataString(searchTags)}");
        }

        return $"/articles?{string.Join("&", query)}";
    }

    private void ToggleBulkForm()
    {
        showBulkForm = !showBulkForm;
        bulkRejectedLines = [];
        bulkFieldErrors.Clear();
    }

    private async Task SubmitBulkAsync()
    {
        var actor = await GetActorAsync();
        if (actor is null)
        {
            return;
        }

        isBulkSubmitting = true;
        bulkFieldErrors.Clear();
        errorMessage = null;
        successMessage = null;
        bulkRejectedLines = [];

        var lines = (bulkLines ?? string.Empty)
            .Replace("\r\n", "\n", StringComparison.Ordinal)
            .Split('\n', StringSplitOptions.None);

        var result = await ArticleCommandService.BulkCreateAsync(
            new BulkCreateArticlesCommand(
                actor.UserId,
                lines,
                bulkH2Count,
                bulkH3Count,
                bulkIsDomesticOnly,
                "Ai",
                "Ai",
                bulkGenerationModel,
                bulkSearchMode,
                ParseGuid(bulkWritingProfileId),
                bulkAutoPostToWordpress,
                ParseGuid(bulkAutoPostSiteId),
                bulkAutoPostCategoryId,
                new BulkGenerationOptions(bulkGenerationScope, bulkSearchMode, bulkXSearch,
                    bulkSearchMode ? bulkWebCount : 10, bulkXSearch ? bulkXCount : 10, bulkXSearch ? bulkXDays : 30)));

        isBulkSubmitting = false;

        if (!result.Succeeded || result.Value is null)
        {
            errorMessage = GetServiceErrorMessage(result.Error, result.ValidationErrors);
            foreach (var validation in result.ValidationErrors)
            {
                var (id, label) = validation.Field.ToLowerInvariant() switch
                {
                    "h2count" => ("bulk-h2", "H2見出し数"),
                    "h3count" => ("bulk-h3", "H3見出し数"),
                    "generation.webresultcount" => ("bulk-web-count", "Web検索件数"),
                    "generation.xresultcount" => ("bulk-x-count", "X検索件数"),
                    "generation.xsearchdays" => ("bulk-x-days", "X検索期間"),
                    "generation.scope" => ("bulk-generation-scope", "生成する内容"),
                    "generationmodel" => ("bulk-model", "生成モデル"),
                    "autopostwordpresssiteid" => ("bulk-auto-post-site", "自動投稿先サイト"),
                    _ => ("bulk-lines", "入力内容")
                };
                bulkFieldErrors[id] = $"{label}：{validation.Message}";
            }
            pendingBulkFocus = bulkFieldErrors.Keys.FirstOrDefault();
            return;
        }

        bulkRejectedLines = result.Value.RejectedLines;
        showBulkForm = result.Value.RejectedLines.Count > 0;
        if (showBulkForm)
        {
            bulkFieldErrors["bulk-lines"] = "未登録の行があります。「キーワード」または「キーワード|タイトル」の形式を確認してください。";
            pendingBulkFocus = "bulk-lines";
        }

        if (result.Value.CreatedArticleCount == 0)
        {
            errorMessage = "登録できる記事がありませんでした。入力内容を確認してください。";
            return;
        }

        bulkLines = showBulkForm
            ? string.Join('\n', bulkRejectedLines.Where(line => line.LineNumber > 0).Select(line => line.Line))
            : null;
        activeBatchId = result.Value.BatchId;
        successMessage = $"{result.Value.CreatedArticleCount}件の記事を登録しました。自動生成を開始しました。";
        await LoadArticlesAsync(1);
    }

    private async Task ResumeArticleAsync(Guid articleId)
    {
        var actor = await GetActorAsync();
        if (actor is null) return;
        resumingArticle = true;
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var result = await scope.ServiceProvider.GetRequiredService<IBulkGenerationService>().RetryAsync(actor, articleId);
            if (!result.Succeeded) errorMessage = "再開できませんでした。生成状況を更新して確認してください。";
            await LoadArticlesAsync(articleList.Page);
            if (bulkProgressPanel is not null) await bulkProgressPanel.RefreshAsync();
        }
        catch (Exception exception)
        {
            errorMessage = "再開できませんでした。状況を更新してから再度お試しください。";
            Logger.LogWarning("Bulk generation resume failed. exceptionType={ExceptionType}", exception.GetType().Name);
        }
        finally { resumingArticle = false; }
    }

    private void ConfirmDelete(ArticleListItemResponse article)
    {
        deleteTarget = article;
    }

    private void CancelDelete()
    {
        deleteTarget = null;
    }

    [JSInvokable]
    public void OnDeleteDialogEscape()
    {
        CancelDelete();
        StateHasChanged();
    }

    private async Task DeleteAsync()
    {
        if (deleteTarget is null)
        {
            return;
        }

        var actor = await GetActorAsync();
        if (actor is null)
        {
            return;
        }

        var result = await ArticleCommandService.DeleteAsync(actor, deleteTarget.Id);
        if (!result.Succeeded)
        {
            errorMessage = GetServiceErrorMessage(result.Error, result.ValidationErrors);
            deleteTarget = null;
            return;
        }

        successMessage = "記事を削除しました。";
        deleteTarget = null;
        await LoadArticlesAsync(articleList.Page);
    }

    private async Task OpenPostDialogAsync(ArticleListItemResponse article)
    {
        postTarget = article;
        postPreview = null;
        postCategories = [];
        isPostDialogLoading = true;
        ClearPostForm();

        var actor = await GetWordpressActorAsync();
        if (actor is null)
        {
            isPostDialogLoading = false;
            return;
        }

        postPreview = await WordpressPostQueryService.GetPreviewAsync(actor, article.Id);
        if (postPreview is not null)
        {
            postForm.Title = postPreview.Title;
            postForm.HtmlBody = postPreview.HtmlBody;
            postForm.Status = WordpressPostStatuses.Draft;
            postForm.SiteId = postPreview.AvailableSites.FirstOrDefault()?.Id.ToString();
            postForm.CategoryId = postPreview.AvailableSites.FirstOrDefault()?.DefaultCategoryId;
            await LoadPostCategoriesAsync();
        }

        isPostDialogLoading = false;
    }

    private void ClosePostDialog()
    {
        postTarget = null;
        postPreview = null;
        postCategories = [];
        postCategoriesError = null;
        postCategoriesUnauthorized = false;
        ClearPostForm();
    }

    private async Task OnPostSiteChangedAsync(ChangeEventArgs args)
    {
        postForm.SiteId = args.Value?.ToString();
        var selectedSite = postPreview?.AvailableSites.FirstOrDefault(site => site.Id.ToString() == postForm.SiteId);
        postForm.CategoryId = selectedSite?.DefaultCategoryId;
        await LoadPostCategoriesAsync();
    }

    private void OnPostCategoryChanged(ChangeEventArgs args)
    {
        postForm.CategoryId = int.TryParse(args.Value?.ToString(), out var categoryId)
            ? categoryId
            : null;
    }

    private async Task LoadPostCategoriesAsync()
    {
        postCategories = [];
        postCategoriesError = null;
        postCategoriesUnauthorized = false;
        var actor = await GetWordpressActorAsync();
        if (actor is null || !Guid.TryParse(postForm.SiteId, out var siteId))
        {
            return;
        }

        var result = await WordpressSiteQueryService.GetCategoriesAsync(actor, siteId);
        if (result.Succeeded && result.Value is not null)
        {
            postCategories = result.Value.Items;
            return;
        }

        // Category list is a convenience, not a requirement: SubmitPostAsync still works with the
        // default category when the failure is category-fetch-only. But WordpressServiceError.Unauthorized
        // means the site's stored credential itself is unusable, and WordpressPostJobHandler posts with
        // that same credential, so submitting would fail identically -- don't tell the user they can
        // post anyway in that case (mobile-ui-dialog-decrypt-followup-2026-09-17 review).
        postCategoriesError = GetWordpressServiceErrorMessage(result.Error, result.ValidationErrors);
        postCategoriesUnauthorized = result.Error == WordpressServiceError.Unauthorized;
    }

    private async Task SubmitPostAsync()
    {
        if (postTarget is null || postPreview is null || !Guid.TryParse(postForm.SiteId, out var siteId))
        {
            return;
        }

        var actor = await GetWordpressActorAsync();
        if (actor is null)
        {
            return;
        }

        isPostSubmitting = true;
        errorMessage = null;
        successMessage = null;

        var result = await WordpressPostCommandService.CreatePostJobAsync(
            new CreateWordpressPostJobCommand(
                actor,
                postTarget.Id,
                siteId,
                postForm.Title,
                postForm.HtmlBody,
                postForm.CategoryId,
                postForm.Status));

        isPostSubmitting = false;

        if (!result.Succeeded || result.Value is null)
        {
            errorMessage = GetWordpressServiceErrorMessage(result.Error, result.ValidationErrors);
            return;
        }

        successMessage = "WordPress投稿ジョブを登録しました。";
        ClosePostDialog();
        await LoadArticlesAsync(articleList.Page);
    }

    private async Task CompleteHumanReviewAsync()
    {
        if (postTarget is null)
        {
            return;
        }

        var actor = await GetActorAsync();
        if (actor is null)
        {
            return;
        }

        isReviewSubmitting = true;
        errorMessage = null;
        successMessage = null;

        var result = await ArticleReviewService.CompleteHumanReviewAsync(
            new CompleteHumanReviewCommand(actor, postTarget.Id, null, null));

        isReviewSubmitting = false;

        if (!result.Succeeded || result.Value is null)
        {
            errorMessage = GetServiceErrorMessage(result.Error, result.ValidationErrors);
            return;
        }

        var wordpressActor = await GetWordpressActorAsync();
        if (wordpressActor is not null)
        {
            postPreview = await WordpressPostQueryService.GetPreviewAsync(wordpressActor, postTarget.Id);
        }

        successMessage = "人間確認を完了しました。公開投稿が可能になりました。";
    }

    private void ClearPostForm()
    {
        postForm.SiteId = null;
        postForm.Title = string.Empty;
        postForm.HtmlBody = string.Empty;
        postForm.CategoryId = null;
        postForm.Status = WordpressPostStatuses.Draft;
    }

    private async Task<ArticleActor?> GetActorAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        return string.IsNullOrWhiteSpace(userId)
            ? null
            : new ArticleActor(userId, user.IsInRole("Admin"));
    }

    private async Task<WordpressActor?> GetWordpressActorAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        return string.IsNullOrWhiteSpace(userId)
            ? null
            : new WordpressActor(userId, user.IsInRole("Admin"));
    }

    private static Guid? ParseGuid(string? value)
    {
        return Guid.TryParse(value, out var guid) ? guid : null;
    }

    private static string GetArticleTitle(ArticleListItemResponse article)
    {
        return string.IsNullOrWhiteSpace(article.Title) ? article.Keyword : article.Title;
    }

    private static string ToDisplayDate(DateTimeOffset value)
    {
        var local = value.ToLocalTime();
        return $"{local:yyyy/M/d HH}時";
    }

    private static string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Completed" or "Posted" => "text-bg-success",
            "Failed" => "text-bg-danger",
            "OutlineGenerating" or "BodyGenerating" => "text-bg-primary",
            "OutlineQueued" or "BodyQueued" => "text-bg-warning",
            _ => "text-bg-secondary"
        };
    }

    private static string GetHeadlineSourceLabel(string headlineSource)
    {
        return headlineSource switch
        {
            "WebSearch" => "WEB検索",
            "Keyword" => "キーワード",
            _ => headlineSource
        };
    }

    private static string GetServiceErrorMessage(
        ArticleServiceError error,
        IReadOnlyList<ArticleValidationError> validationErrors)
    {
        if (validationErrors.Count > 0)
        {
            return string.Join(" ", validationErrors.Select(item => item.Message));
        }

        return error switch
        {
            ArticleServiceError.NotFound => "対象データが見つかりません。",
            ArticleServiceError.ConflictRunningJob => "実行中ジョブがあるため削除できません。",
            ArticleServiceError.ConcurrencyConflict => "他の操作により記事が更新されています。",
            ArticleServiceError.RateLimited => "短時間に連続して実行されています。時間をおいて再実行してください。",
            _ => "処理に失敗しました。"
        };
    }

    private static string GetWordpressServiceErrorMessage(
        WordpressServiceError error,
        IReadOnlyList<WordpressValidationError> validationErrors)
    {
        if (validationErrors.Count > 0)
        {
            return string.Join(" ", validationErrors.Select(item => item.Message));
        }

        return error switch
        {
            WordpressServiceError.NotFound => "対象データが見つかりません。",
            WordpressServiceError.Conflict => "WordPress投稿ジョブがすでに待機中または実行中です。",
            WordpressServiceError.HumanReviewRequired => "人間確認前の記事は公開投稿できません。",
            WordpressServiceError.NotPostable => "投稿可能な記事状態ではありません。",
            WordpressServiceError.ExternalFailure => "WordPress連携に失敗しました。",
            WordpressServiceError.RateLimited => "短時間に連続して実行されています。時間をおいて再実行してください。",
            _ => "WordPress投稿に失敗しました。"
        };
    }

    private sealed class WordpressPostForm
    {
        public string? SiteId { get; set; }

        public string Title { get; set; } = string.Empty;

        public string HtmlBody { get; set; } = string.Empty;

        public int? CategoryId { get; set; }

        public string Status { get; set; } = WordpressPostStatuses.Draft;
    }
