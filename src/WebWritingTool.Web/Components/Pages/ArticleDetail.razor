    {
        return status switch
        {
            "Draft" => "下書き",
            "OutlineQueued" => "構成待機",
            "OutlineGenerating" => "構成生成中",
            "OutlineReady" => "構成完了",
            "BodyQueued" => "本文待機",
            "BodyGenerating" => "本文生成中",
            "Completed" => "記事完成",
            "Posted" => "投稿済み",
            "Failed" => "失敗",
            _ => status
        };
    }

    private static string GetHeadingStatusLabel(string status)
    {
        return status switch
        {
            "Pending" => "未着手",
            "Queued" => "生成待ち",
            "Generating" => "生成中",
            "Generated" => "生成済み",
            "Failed" => "失敗",
            _ => status
        };
    }

    private static string GetServiceErrorMessage(
        ArticleServiceError error,
        IReadOnlyList<ArticleValidationError> validationErrors)
    {
        if (validationErrors.Count > 0)
        {
            return string.Join(" ", validationErrors.Select(item => item.Message));
        }

        return error switch
        {
            ArticleServiceError.NotFound => "記事が見つかりません。",
            ArticleServiceError.ConflictRunningJob => "実行中ジョブがあるため削除できません。",
            ArticleServiceError.ConflictGeneratingHeading => "生成待ちまたは生成中の見出しは操作できません。",
            ArticleServiceError.ConcurrencyConflict => "他の操作により更新されています。入力内容はこの画面に残っています。必要な内容をコピーしてから画面を開き直してください。",
            _ => "処理に失敗しました。"
        };
    }

    private IServiceScope CreateOperationScope()
    {
        var scope = ScopeFactory.CreateScope();
        if (ExecutionContext.IsGuest)
            scope.ServiceProvider.GetRequiredService<ExternalApiExecutionContext>().EnableGuestMode();
        return scope;
    }

    private Task SaveAllAsync() => SaveAsync(SaveAllCoreAsync);

    private async Task SaveAllCoreAsync()
    {
        if (IsArticleDirty) { await SaveArticleCoreAsync(); if (errorMessage is not null) return; }
        if (IsHeadingDirty) await SaveHeadingCoreAsync();
    }

    private async Task SaveAsync(Func<Task> action)
    {
        if (IsEditorBusy) return;
        isSubmitting = true;
        isSaving = true;
        saveFailed = false;
        ClearMessages();
        try
        {
            await action();
            saveFailed = errorMessage is not null;
        }
        catch (Exception exception)
        {
            saveFailed = true;
            errorMessage = "保存できませんでした。入力内容は画面に残っています。もう一度お試しください。";
            Logger.LogWarning("Saving article failed. exceptionType={ExceptionType}", exception.GetType().Name);
        }
        finally
        {
            isSaving = false;
            isSubmitting = false;
        }
    }

    private async Task GuardAsync(Func<Task> action)
    {
        if (IsEditorBusy) return;
        if (!await ConfirmUnsavedAsync()) return;
        isSubmitting = true;
        try { await action(); }
        finally { isSubmitting = false; }
    }

    private Task<bool> ConfirmUnsavedAsync()
    {
        if (!HasUnsavedChanges) return Task.FromResult(true);
        unsavedChoice ??= new(TaskCreationOptions.RunContinuationsAsynchronously);
        StateHasChanged();
        return unsavedChoice.Task;
    }

    private void CompleteUnsaved(bool proceed)
    {
        var pending = unsavedChoice;
        unsavedChoice = null;
        pending?.TrySetResult(proceed);
    }

    private void CancelUnsaved() => CompleteUnsaved(false);

    private async Task DiscardUnsavedAsync()
    {
        await LoadAsync(selectedHeading?.Id);
        CompleteUnsaved(true);
    }

    private async Task SaveAndContinueAsync()
    {
        await SaveAllAsync();
        if (!HasUnsavedChanges && errorMessage is null) CompleteUnsaved(true);
    }

    private async Task BeforeNavigationAsync(LocationChangingContext context)
    {
        if (!await ConfirmUnsavedAsync()) context.PreventNavigation();
    }

    [JSInvokable]
    public async Task ConfirmLinkNavigationAsync(string destination)
    {
        if (disposed || isSubmitting || !await ConfirmUnsavedAsync()) return;
        if (navigationModule is not null)
            await navigationModule.InvokeVoidAsync("setDirty", editorRoot, false);
        NavigationManager.NavigateTo(destination, forceLoad: true);
    }

    private Task SelectHeadingAsync(Guid id)
    {
        SelectHeading(id);
        showOutline = false;
        showHeadingTools = false;
        focusEditor = true;
        return Task.CompletedTask;
    }

    private Task ChangeHeadingAsync(int direction) => GuardAsync(async () =>
    {
        var headings = article?.Headings.OrderBy(heading => heading.DisplayOrder).ToArray() ?? [];
        var index = SelectedHeadingIndex + direction;
        if (index >= 0 && index < headings.Length) await SelectHeadingAsync(headings[index].Id);
    });

    private void ToggleFocusMode()
    {
        focusPreference = !FocusMode;
        showOutline = false;
        focusEditor = FocusMode;
    }

    private void FocusError() => focusError = true;

    [JSInvokable]
    public Task SetShortViewportAsync(bool value)
    {
        if (disposed) return Task.CompletedTask;
        shortViewport = value;
        return InvokeAsync(StateHasChanged);
    }

    private Task ToggleMetaAsync()
    {
        showMetaPanel = !showMetaPanel;
        if (showMetaPanel) focusPreference = false;
        focusMeta = showMetaPanel;
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var imported = await JS.InvokeAsync<IJSObjectReference>("import", "./js/editorNavigation.js");
            if (disposed) { await imported.DisposeAsync(); return; }
            navigationModule = imported;
            navigationReference = DotNetObjectReference.Create(this);
            await navigationModule.InvokeVoidAsync("watch", editorRoot, navigationReference);
            var importedViewport = await JS.InvokeAsync<IJSObjectReference>("import", "./js/editorViewport.js");
            if (disposed) { await importedViewport.DisposeAsync(); return; }
            viewportModule = importedViewport;
            await viewportModule.InvokeVoidAsync("watch", editorRoot, navigationReference);
        }
        if (navigationModule is not null)
            await navigationModule.InvokeVoidAsync("setDirty", editorRoot, HasUnsavedChanges);
        if (!focusMeta && !focusEditor && !focusError) return;
        var id = focusError ? "editor-error" : focusMeta ? "article-meta" : "heading-editor";
        focusMeta = focusEditor = focusError = false;
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/appDialog.js");
        await module.InvokeVoidAsync("focus", id);
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        CompleteUnsaved(false);
        if (viewportModule is not null)
        {
            try
            {
                await viewportModule.InvokeVoidAsync("stop", editorRoot);
                await viewportModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                Logger.LogDebug("Skipped editor viewport cleanup because the circuit disconnected.");
            }
        }
        if (navigationModule is not null)
        {
            try
            {
                await navigationModule.InvokeVoidAsync("stop", editorRoot);
                await navigationModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                Logger.LogDebug("Skipped editor navigation cleanup because the circuit disconnected before disposal ran.");
            }
        }
        navigationReference?.Dispose();
    }

