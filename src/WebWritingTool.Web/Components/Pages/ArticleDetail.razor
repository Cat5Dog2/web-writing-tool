@page "/articles/{ArticleId:guid}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable

@using System.Security.Claims
@using WebWritingTool.Web.Components.Articles
@using WebWritingTool.Application.Jobs
@using WebWritingTool.Application.Security
@inject IServiceScopeFactory ScopeFactory
@inject ExternalApiExecutionContext ExecutionContext
@inject IJSRuntime JS
@inject ILogger<ArticleDetail> Logger

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<PageTitle>@(article?.Title ?? "生成結果編集")</PageTitle>
<NavigationLock OnBeforeInternalNavigation="BeforeNavigationAsync" />

<div class="article-page article-editor-page @(FocusMode ? "editor-focus-mode" : "")" @ref="editorRoot">
    <header class="article-page-header">
        <div>
            <h1>@(article?.Title ?? article?.Keyword ?? "生成結果編集")</h1>
        </div>
        <div class="article-actions">
            <a class="btn btn-outline-secondary" href="/articles" aria-label="一覧へ戻る">← 一覧</a>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div id="editor-error" tabindex="-1" class="alert alert-danger" role="alert">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    @if (isLoading)
    {
        <div class="text-muted">読み込み中</div>
    }
    else if (article is null)
    {
        <div class="alert alert-warning" role="alert">記事が見つかりません。</div>
    }
    else
    {
        <section class="article-panel article-editor-toolbar">
            <div class="editor-status" aria-label="記事の状態">
                <span class="badge @(article.Status is "Completed" or "Posted" ? "text-bg-success" : article.Status == "Failed" ? "text-bg-danger" : "text-bg-light")">@GetArticleStatusLabel(article.Status)</span>
            </div>
            <div class="article-editor-actions">
                <div class="editor-save-feedback">
                    <span id="editor-save-message" class="editor-save-state @(saveFailed ? "text-danger" : "")" role="status">@SaveStateText</span>
                    @if (errorMessage is not null)
                    { <button type="button" class="btn btn-link" @onclick="FocusError">エラーを確認</button> }
                </div>
                <div class="editor-save-buttons">
                    <button type="button" class="btn btn-outline-primary" aria-label="変更をまとめて保存" aria-describedby="editor-save-message" disabled="@IsEditorBusy" @onclick="SaveAllAsync">保存</button>
                    <button type="button" class="btn btn-primary" disabled="@IsEditorBusy" @onclick="SaveAndPreviewAsync">@(isPreparingPreview ? "プレビューを準備中…" : "保存してプレビュー")</button>
                </div>
            </div>
        </section>
        <div class="article-editor-options">
            <button type="button" class="btn btn-link" aria-expanded="@showMetaPanel" @onclick="ToggleMetaAsync">
                記事情報@(showMetaPanel ? "を閉じる" : "を編集")
            </button>
            <BulkGenerationPanel ArticleId="ArticleId" OnProgressChanged="ReloadWorkflowAsync" OnActiveChanged="value => automaticGenerationActive = value" />
        </div>

        @if (showMetaPanel)
        {
            <section id="article-meta" tabindex="-1" class="article-panel article-editor-meta mb-3">
                <h2 class="h5">記事情報</h2>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label" for="title">タイトル</label>
                        <input id="title" class="form-control" disabled="@IsEditorBusy" @bind="form.Title" @bind:event="oninput" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="keyword">キーワード</label>
                        <input id="keyword" class="form-control" disabled="@IsEditorBusy" @bind="form.Keyword" @bind:event="oninput" />
                    </div>
                    <div class="col-12">
                        <label class="form-label" for="meta-description">メタディスクリプション</label>
                        <textarea id="meta-description" class="form-control" disabled="@IsEditorBusy" rows="4" @bind="form.MetaDescription" @bind:event="oninput"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="tags">タグ</label>
                        <input id="tags" class="form-control" disabled="@IsEditorBusy" @bind="form.Tags" @bind:event="oninput" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="memo">メモ</label>
                        <textarea id="memo" class="form-control" disabled="@IsEditorBusy" rows="3" @bind="form.Memo" @bind:event="oninput"></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="generation-model">生成モデル</label>
                        <select id="generation-model" class="form-select" disabled="@IsEditorBusy" @bind="form.GenerationModel">
                            @foreach (var model in formOptions.GenerationModels)
                            {
                                <option value="@model.Model">@model.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="outline-method">構成</label>
                        <select id="outline-method" class="form-select" disabled="@IsEditorBusy" @bind="form.OutlineMethod">
                            <option value="Keyword">キーワード</option>
                            <option value="Search">検索</option>
                            <option value="Ai">AI</option>
                        </select>
                    </div>
                    <div class="col-12 d-flex flex-wrap gap-3">
                        <div class="form-check">
                            <input id="search-mode" class="form-check-input" disabled="@IsEditorBusy" type="checkbox" @bind="form.SearchMode" />
                            <label class="form-check-label" for="search-mode">検索モード</label>
                        </div>
                        <div class="form-check">
                            <input id="is-domestic" class="form-check-input" disabled="@IsEditorBusy" type="checkbox" @bind="form.IsDomesticOnly" />
                            <label class="form-check-label" for="is-domestic">国内限定</label>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-outline-primary mt-3" disabled="@IsEditorBusy" @onclick="SaveArticleAsync">記事情報を保存</button>
            </section>
        }

        <div class="editor-mobile-switch" role="group" aria-label="編集表示">
            <button class="btn @(showOutline ? "btn-outline-primary" : "btn-primary")" aria-pressed="@(!showOutline)" @onclick="() => showOutline = false">本文</button>
            <button class="btn @(showOutline ? "btn-primary" : "btn-outline-primary")" aria-label="@($"見出し構成（{article.Headings.Count}）")" aria-pressed="@showOutline" @onclick="() => showOutline = true">構成（@article.Headings.Count）</button>
            <button class="btn btn-outline-secondary" aria-expanded="@(!FocusMode)" @onclick="ToggleFocusMode">@(FocusMode ? "全体を表示" : "本文に集中")</button>
        </div>
        <fieldset disabled="@IsEditorBusy" class="editor-fields">
        <div class="article-editor-grid @(showOutline ? "show-outline" : "show-body")">
            <aside class="article-editor-sidebar">
                <section class="article-panel">
                    <div class="article-section-header">
                        <h2 class="h5">見出し構成</h2>
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-primary" @onclick="() => GuardAsync(AddH2Async)">H2追加</button>
                            <button type="button" class="btn btn-outline-primary" disabled="@(!CanAddH3)" @onclick="() => GuardAsync(AddH3Async)">H3追加</button>
                        </div>
                    </div>

                    @if (article.Headings.Count == 0)
                    {
                        <div class="text-muted">見出しはありません。</div>
                    }
                    else
                    {
                        <div class="article-outline-tree">
                            @foreach (var group in GetHeadingGroups())
                            {
                                @RenderHeadingButton(group.Heading)
                                @foreach (var child in group.Children)
                                {
                                    @RenderHeadingButton(child)
                                }
                            }
                        </div>
                    }

                </section>
            </aside>

            <div class="article-editor-main" id="heading-editor" tabindex="-1">
                @if (selectedHeading is null)
                {
                    <section class="article-panel">
                        <div class="text-muted">編集する見出しを選択してください。</div>
                    </section>
                }
                else
                {
                    <section class="article-panel article-heading-editor">
                        <nav class="heading-navigation" aria-label="見出し間の移動">
                            <button type="button" class="btn btn-outline-secondary" disabled="@(SelectedHeadingIndex <= 0)" @onclick="() => ChangeHeadingAsync(-1)">前の見出し</button>
                            <span class="heading-position" aria-live="polite">@(SelectedHeadingIndex + 1) / @article.Headings.Count</span>
                            <button type="button" class="btn btn-outline-secondary" disabled="@(SelectedHeadingIndex >= article.Headings.Count - 1)" @onclick="() => ChangeHeadingAsync(1)">次の見出し</button>
                        </nav>
                        <div class="article-section-header">
                            <div>
                                <span class="badge text-bg-light">@($"H{selectedHeading.Level}")</span>
                                <span class="badge text-bg-secondary ms-1">@GetHeadingStatusLabel(selectedHeading.Status)</span>
                            </div>
                            <button id="heading-tools-toggle" type="button" class="btn btn-outline-secondary" aria-expanded="@showHeadingTools" aria-controls="heading-tools" @onclick="() => showHeadingTools = !showHeadingTools">見出しの操作</button>
                        </div>
                        @if (showHeadingTools)
                        {
                            <div id="heading-tools" class="heading-tools" role="group" aria-label="見出しの補助操作">
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => GuardAsync(() => MoveSelectedHeadingAsync(-1))">上へ移動</button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => GuardAsync(() => MoveSelectedHeadingAsync(1))">下へ移動</button>
                                <button type="button" class="btn btn-outline-danger" @onclick="() => RequestDeleteHeadingAsync(selectedHeading.Id)">削除</button>
                            </div>
                        }

                        <div class="mb-3 heading-title-field">
                            <label class="form-label" for="heading-title">見出しタイトル</label>
                            <input id="heading-title" class="form-control" @bind="headingForm.Title" @bind:event="oninput" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label heading-body-label" for="heading-body">本文 <span class="editor-focus-title">@selectedHeading.Title</span></label>
                            @if (ExecutionContext.IsGuest) { <span class="editor-focus-guest">ゲスト · サンプル</span> }
                            <textarea id="heading-body" class="form-control article-body-editor" rows="18" @bind="headingForm.Body" @bind:event="oninput"></textarea>
                        </div>

                        <div class="article-heading-editor-footer">
                            <div class="article-heading-settings">
                                <label class="form-label" for="target-length">目安文字数</label>
                                <input id="target-length" class="form-control" type="number" min="0" @bind="headingForm.TargetLength" />
                                <label class="form-check">
                                    <input class="form-check-input" type="checkbox" @bind="headingForm.UseWebSearch" />
                                    <span class="form-check-label">Web検索</span>
                                </label>
                            </div>
                            <div class="article-heading-save">
                                <span class="text-muted">@HeadingBodyLength 文字</span>
                                <button type="button" class="btn btn-outline-primary" disabled="@IsEditorBusy" @onclick="SaveHeadingAsync">本文を保存</button>
                            </div>
                        </div>
                        <div class="editor-feedback" aria-live="polite">@(errorMessage ?? successMessage)</div>
                        @if (errorMessage is not null && IsHeadingDirty)
                        { <CopyText Text="@(headingForm.Body ?? string.Empty)" Label="未保存の本文をコピー" /> }
                    </section>
                }
            </div>
        </div>

        </fieldset>
        <details class="preview-options article-panel mt-3">
            <summary>プレビューの表示設定</summary>
            <label class="form-check article-period-break">
                <input class="form-check-input" type="checkbox" disabled="@IsEditorBusy" @bind="insertLineBreakAfterPeriod" />
                <span class="form-check-label">句点で改行する</span>
            </label>
            <p class="form-text mb-0">「保存してプレビュー」で反映します。</p>
        </details>
        <WebWritingTool.Web.Components.Articles.ArticleResearchPanel @key="ArticleId" ArticleId="ArticleId"
            Keyword="@article.Keyword" SearchMode="article.SearchMode" Headings="article.Headings"
            InitialJobId="monitoredOutlineJobId" Disabled="@(automaticGenerationActive || isSubmitting || isPreparingPreview)" BeforeGenerate="ConfirmUnsavedAsync" OnBusyChanged="value => manualGenerationActive = value" OnGenerated="ReloadGeneratedArticleAsync" />
        <div class="article-editor-danger">
            <button type="button" class="btn btn-outline-danger" disabled="@IsEditorBusy" @onclick="() => showDeleteDialog = true">記事を削除</button>
        </div>
    }
</div>

@if (deleteHeadingId.HasValue)
{
    var target = article?.Headings.FirstOrDefault(heading => heading.Id == deleteHeadingId);
    <AppDialog Title="見出しを削除" OnClose="CancelDeleteHeading" ReturnFocusId="heading-tools-toggle">
        <p><strong>@target?.Title</strong></p>
        <p>この見出しと本文@(target?.Level == 2 ? $"、配下のH3 {article!.Headings.Count(heading => heading.ParentId == target.Id)}件とその本文" : "")を削除します。画面から元には戻せません。</p>
        @if (errorMessage is not null) { <div class="alert alert-danger" role="alert">@errorMessage</div> }
        <div class="d-flex flex-wrap gap-2 justify-content-end">
            <button class="btn btn-outline-secondary" disabled="@IsEditorBusy" autofocus @onclick="CancelDeleteHeading">キャンセル</button>
            <button class="btn btn-danger" disabled="@IsEditorBusy" @onclick="() => GuardAsync(ConfirmDeleteHeadingAsync)">削除する</button>
        </div>
    </AppDialog>
}
@if (unsavedChoice is not null)
{
    <AppDialog Title="未保存の変更" OnClose="CancelUnsaved">
        <p>記事情報または本文に未保存の変更があります。保存してから続けますか。</p>
        @if (errorMessage is not null) { <div class="alert alert-danger" role="alert">@errorMessage</div> }
        <div class="d-flex flex-wrap gap-2 justify-content-end">
            <button class="btn btn-outline-secondary" disabled="@isSubmitting" autofocus @onclick="CancelUnsaved">キャンセル</button>
            <button class="btn btn-outline-danger" disabled="@isSubmitting" @onclick="DiscardUnsavedAsync">変更を破棄</button>
            <button class="btn btn-primary" disabled="@isSubmitting" @onclick="SaveAndContinueAsync">保存して続ける</button>
        </div>
    </AppDialog>
}
@if (showDeleteDialog)
{
    <AppDialog Title="記事を削除" OnClose="() => showDeleteDialog = false">
        <p>@article?.Title</p>
        <p>この記事と配下の見出し・本文を一覧から削除します。画面から元には戻せません。待機中のジョブはキャンセルされます。</p>
        <div class="d-flex gap-2 justify-content-end">
            <button class="btn btn-outline-secondary" autofocus @onclick="() => showDeleteDialog = false">キャンセル</button>
            <button class="btn btn-danger" @onclick="DeleteArticleAsync">削除</button>
        </div>
    </AppDialog>
}

@code {
    [Parameter]
    public Guid ArticleId { get; set; }

    [SupplyParameterFromQuery(Name = "job")] public Guid? InitialJobId { get; set; }
    [SupplyParameterFromQuery(Name = "heading")] public Guid? RequestedHeadingId { get; set; }
    private ArticleEditForm savedForm = new();
    private HeadingEditForm savedHeadingForm = new();
    private bool IsArticleDirty => form != savedForm;
    private bool IsHeadingDirty => selectedHeading is not null && headingForm != savedHeadingForm;
    private bool HasUnsavedChanges => IsArticleDirty || IsHeadingDirty;
    private TaskCompletionSource<bool>? unsavedChoice;
    private bool showDeleteDialog;
    private bool showOutline;
    private bool showHeadingTools;
    private bool shortViewport;
    private bool? focusPreference;
    private bool FocusMode => focusPreference ?? shortViewport;
    private bool manualGenerationActive;
    private bool automaticGenerationActive;
    private bool isGenerating => manualGenerationActive || automaticGenerationActive;
    private Guid? monitoredOutlineJobId;
    private bool focusMeta;
    private bool focusEditor;
    private bool focusError;
    private ElementReference editorRoot;
    private IJSObjectReference? navigationModule;
    private IJSObjectReference? viewportModule;
    private DotNetObjectReference<ArticleDetail>? navigationReference;
    private bool disposed;
    private ArticleDetailResponse? article;
    private ArticleFormOptionsResponse formOptions = new([], []);
    private ArticleHeadingResponse? selectedHeading;
    private ArticleEditForm form = new();
    private HeadingEditForm headingForm = new();
    private bool isLoading = true;
    private bool isSubmitting;
    private bool isPreparingPreview;
    private bool isSaving;
    private bool saveFailed;
    private string SaveStateText => isSaving ? "保存中…"
        : isPreparingPreview ? "プレビューを準備中…"
        : saveFailed ? "保存に失敗しました"
        : HasUnsavedChanges ? "未保存の変更があります" : "保存済み";
    private bool IsEditorBusy => isSubmitting || isPreparingPreview || isGenerating;
    private bool showMetaPanel;
    private bool insertLineBreakAfterPeriod;
    private Guid? deleteHeadingId;
    private string? errorMessage;
    private string? successMessage;

    private bool CanAddH3 => article is not null && GetSelectedH2Id().HasValue;

    private int HeadingBodyLength => headingForm.Body?.Length ?? 0;
    private int SelectedHeadingIndex => article?.Headings.OrderBy(heading => heading.DisplayOrder).ToList()
        .FindIndex(heading => heading.Id == selectedHeading?.Id) ?? -1;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(RequestedHeadingId);
    }

    private async Task LoadAsync(Guid? preferredHeadingId = null)
    {
        using var scope = CreateOperationScope();
        var actor = await GetActorAsync();
        if (actor is null)
        {
            isLoading = false;
            return;
        }

        formOptions = await scope.ServiceProvider.GetRequiredService<IArticleQueryService>().GetFormOptionsAsync(actor.UserId);
        article = await scope.ServiceProvider.GetRequiredService<IArticleQueryService>().GetAsync(actor, ArticleId);
        var workflow = await scope.ServiceProvider.GetRequiredService<IBulkGenerationService>().GetProgressAsync(actor, articleId: ArticleId);
        automaticGenerationActive = workflow.Any(item => item.IsActive);
        monitoredOutlineJobId = InitialJobId;
        if (article is not null)
        {
            if (workflow.Count > 0) monitoredOutlineJobId = null;
            if (workflow.Count == 0 && !monitoredOutlineJobId.HasValue && article.Status is "OutlineQueued" or "OutlineGenerating")
            {
                var jobs = await scope.ServiceProvider.GetRequiredService<IJobQueryService>().ListForArticleAsync(
                    new JobActor(actor.UserId, actor.IsAdmin), new ArticleJobListQuery(ArticleId, null, "OutlineGeneration"));
                monitoredOutlineJobId = jobs?.Items.FirstOrDefault()?.Id;
            }
            PopulateForm(article);
            SelectHeading(preferredHeadingId ?? selectedHeading?.Id ?? article.Headings.FirstOrDefault()?.Id);
        }

        isLoading = false;
    }

    private async Task ReloadGeneratedArticleAsync()
    {
        await LoadAsync();
        if (InitialJobId.HasValue)
            NavigationManager.NavigateTo(NavigationManager.GetUriWithQueryParameter("job", (string?)null), replace: true);
    }

    private async Task ReloadWorkflowAsync()
    {
        if (!HasUnsavedChanges && !IsEditorBusy) await LoadAsync();
    }

    private void PopulateForm(ArticleDetailResponse detail)
    {
        form.Keyword = detail.Keyword;
        form.Title = detail.Title ?? string.Empty;
        form.Tags = string.Join(", ", detail.Tags);
        form.Memo = detail.Memo;
        form.Tone = detail.Tone ?? "Normal";
        form.SuggestedKeywords = detail.SuggestedKeywords;
        form.RelatedKeywords = detail.RelatedKeywords;
        form.LearningType = detail.LearningType ?? "None";
        form.LearningText = detail.LearningText;
        form.AdditionalPrompt = detail.AdditionalPrompt;
        form.MetaDescription = detail.MetaDescription;
        form.GenerationModel = detail.GenerationModel ?? formOptions.GenerationModels.FirstOrDefault()?.Model ?? string.Empty;
        form.OutlineMethod = detail.OutlineMethod;
        form.SearchMode = detail.SearchMode;
        form.IsDomesticOnly = detail.IsDomesticOnly;
        form.NotificationMode = detail.NotificationMode;
        form.WritingProfileWordpressSiteId = detail.WritingProfileWordpressSiteId?.ToString();
        form.RowVersion = detail.RowVersion;
        savedForm = form with { };
    }

    private void SelectHeading(Guid? headingId)
    {
        selectedHeading = headingId.HasValue && article is not null
            ? article.Headings.FirstOrDefault(heading => heading.Id == headingId.Value)
            : null;

        if (selectedHeading is null)
        {
            headingForm.Title = string.Empty;
            headingForm.Body = null;
            headingForm.TargetLength = null;
            headingForm.UseWebSearch = false;
            headingForm.RowVersion = null;
            savedHeadingForm = headingForm with { };
            return;
        }

        headingForm.Title = selectedHeading.Title;
        headingForm.Body = selectedHeading.Body;
        headingForm.TargetLength = selectedHeading.TargetLength;
        headingForm.UseWebSearch = selectedHeading.UseWebSearch;
        headingForm.RowVersion = selectedHeading.RowVersion;
        savedHeadingForm = headingForm with { };
    }

    private Task SaveArticleAsync() => SaveAsync(SaveArticleCoreAsync);

    private async Task SaveArticleCoreAsync()
    {
        using var scope = CreateOperationScope();
        var actor = await GetActorAsync();
        if (actor is null || article is null)
        {
            return;
        }

        ClearMessages();

        var result = await scope.ServiceProvider.GetRequiredService<IArticleCommandService>().UpdateAsync(
            new UpdateArticleCommand(
                actor,
                ArticleId,
                form.Keyword,
                form.Title,
                ArticleInputNormalizer.SplitTags(form.Tags),
                form.Memo,
                form.Tone,
                form.SuggestedKeywords,
                form.RelatedKeywords,
                form.LearningType,
                form.LearningText,
                form.AdditionalPrompt,
                form.MetaDescription,
                form.GenerationModel,
                form.OutlineMethod,
                form.SearchMode,
                form.IsDomesticOnly,
                form.NotificationMode,
                ParseGuid(form.WritingProfileWordpressSiteId),
                article.Body,
                article.HtmlBody,
                form.RowVersion));

        if (!result.Succeeded || result.Value is null)
        {
            errorMessage = GetServiceErrorMessage(result.Error, result.ValidationErrors);
            return;
        }

        article = result.Value;
        PopulateForm(result.Value);
        successMessage = "記事を保存しました。";
    }

    private Task SaveHeadingAsync() => SaveAsync(SaveHeadingCoreAsync);

    private async Task SaveHeadingCoreAsync()
    {
        using var scope = CreateOperationScope();
        var actor = await GetActorAsync();
        if (actor is null || selectedHeading is null)
        {
            return;
        }

        ClearMessages();

        var result = await scope.ServiceProvider.GetRequiredService<IArticleHeadingService>().UpdateHeadingAsync(
            new UpdateArticleHeadingCommand(
                actor,
                ArticleId,
                selectedHeading.Id,
                headingForm.Title,
                headingForm.Body,
                headingForm.TargetLength,
                headingForm.UseWebSearch,
                headingForm.RowVersion));

        if (!result.Succeeded || result.Value is null)
        {
            errorMessage = GetServiceErrorMessage(result.Error, result.ValidationErrors);
            return;
        }

        // A heading save changes the article version; keep unrelated metadata edits intact.
        var metadata = IsArticleDirty ? form with { } : null;
        var metadataBaseline = savedForm;
        await LoadAsync(result.Value.Id);
        if (metadata is not null)
        {
            // Advance the version only when the stored metadata still matches the original
            // edit baseline. A concurrent metadata edit must continue to raise a conflict.
            var unchanged = (savedForm with { RowVersion = null }) == (metadataBaseline with { RowVersion = null });
            form = metadata with { RowVersion = unchanged ? savedForm.RowVersion : metadata.RowVersion };
        }
        successMessage = "本文を保存しました。";
    }

    private async Task AddH2Async()
    {
        await CreateHeadingAsync(level: 2, parentId: null, title: "新しいH2");
    }

    private async Task AddH3Async()
    {
        var parentId = GetSelectedH2Id();
        if (!parentId.HasValue)
        {
            return;
        }

        await CreateHeadingAsync(level: 3, parentId: parentId.Value, title: "新しいH3");
    }

    private async Task CreateHeadingAsync(int level, Guid? parentId, string title)
    {
        using var scope = CreateOperationScope();
        var actor = await GetActorAsync();
        if (actor is null)
        {
            return;
        }

        ClearMessages();
        var result = await scope.ServiceProvider.GetRequiredService<IArticleHeadingService>().CreateHeadingAsync(
            new CreateArticleHeadingCommand(
                actor,
                ArticleId,
                parentId,
                level,
                title,
                selectedHeading?.Id,
                TargetLength: null,
                UseWebSearch: false));

        if (!result.Succeeded || result.Value is null)
        {
            errorMessage = GetServiceErrorMessage(result.Error, result.ValidationErrors);
            return;
        }

        await LoadAsync(result.Value.Id);
        successMessage = "見出しを追加しました。";
    }

    private async Task RequestDeleteHeadingAsync(Guid headingId)
    {
        if (IsEditorBusy || !await ConfirmUnsavedAsync()) return;
        ClearMessages();
        showHeadingTools = false;
        deleteHeadingId = headingId;
    }

    private void CancelDeleteHeading()
    {
        deleteHeadingId = null;
    }

    private async Task ConfirmDeleteHeadingAsync()
    {
        if (!deleteHeadingId.HasValue)
        {
            return;
        }

        using var scope = CreateOperationScope();
        var actor = await GetActorAsync();
        if (actor is null)
        {
            return;
        }

        ClearMessages();
        var result = await scope.ServiceProvider.GetRequiredService<IArticleHeadingService>().DeleteHeadingAsync(actor, ArticleId, deleteHeadingId.Value);
        if (!result.Succeeded)
        {
            errorMessage = GetServiceErrorMessage(result.Error, result.ValidationErrors);
            return;
        }

        deleteHeadingId = null;
        selectedHeading = null;
        await LoadAsync();
        successMessage = "見出しを削除しました。";
    }

    private async Task MoveSelectedHeadingAsync(int direction)
    {
        if (article is null || selectedHeading is null)
        {
            return;
        }

        var flattened = selectedHeading.Level == 2
            ? MoveH2Group(direction)
            : MoveH3WithinParent(direction);

        if (flattened is null)
        {
            return;
        }

        using var scope = CreateOperationScope();
        var actor = await GetActorAsync();
        if (actor is null)
        {
            return;
        }

        ClearMessages();
        var items = flattened
            .Select((heading, index) => new ArticleHeadingOrderItem(
                heading.Id,
                heading.Level == 3 ? heading.ParentId : null,
                (index + 1) * 10))
            .ToArray();

        var result = await scope.ServiceProvider.GetRequiredService<IArticleHeadingService>().UpdateHeadingOrderAsync(
            new UpdateArticleHeadingOrderCommand(actor, ArticleId, items));

        if (!result.Succeeded)
        {
            errorMessage = GetServiceErrorMessage(result.Error, result.ValidationErrors);
            return;
        }

        await LoadAsync(selectedHeading.Id);
        successMessage = "見出し順を更新しました。";
    }

    private IReadOnlyList<ArticleHeadingResponse>? MoveH2Group(int direction)
    {
        var groups = GetHeadingGroups().ToList();
        var index = groups.FindIndex(group => group.Heading.Id == selectedHeading?.Id);
        var newIndex = index + direction;
        if (index < 0 || newIndex < 0 || newIndex >= groups.Count)
        {
            return null;
        }

        (groups[index], groups[newIndex]) = (groups[newIndex], groups[index]);
        return groups.SelectMany(group => new[] { group.Heading }.Concat(group.Children)).ToArray();
    }

    private IReadOnlyList<ArticleHeadingResponse>? MoveH3WithinParent(int direction)
    {
        if (selectedHeading?.ParentId is null)
        {
            return null;
        }

        var groups = GetHeadingGroups().ToList();
        var targetGroup = groups.FirstOrDefault(group => group.Heading.Id == selectedHeading.ParentId.Value);
        if (targetGroup is null)
        {
            return null;
        }

        var children = targetGroup.Children.ToList();
        var index = children.FindIndex(child => child.Id == selectedHeading.Id);
        var newIndex = index + direction;
        if (index < 0 || newIndex < 0 || newIndex >= children.Count)
        {
            return null;
        }

        (children[index], children[newIndex]) = (children[newIndex], children[index]);

        return groups
            .SelectMany(group =>
            {
                var groupChildren = group.Heading.Id == targetGroup.Heading.Id
                    ? children
                    : group.Children;
                return new[] { group.Heading }.Concat(groupChildren);
            })
            .ToArray();
    }

    private async Task ConvertHtmlAsync()
    {
        using var scope = CreateOperationScope();
        var actor = await GetActorAsync();
        if (actor is null)
        {
            return;
        }

        isSubmitting = true;
        ClearMessages();

        var result = await scope.ServiceProvider.GetRequiredService<IArticleContentService>().ConvertHtmlAsync(
            new ConvertArticleHtmlCommand(actor, ArticleId, insertLineBreakAfterPeriod));

        if (!result.Succeeded || result.Value is null)
        {
            isSubmitting = false;
            errorMessage = GetServiceErrorMessage(result.Error, result.ValidationErrors);
            return;
        }

        await LoadAsync(selectedHeading?.Id);
        isSubmitting = false;
        successMessage = "HTMLへ変換しました。";
    }

    private async Task SaveAndPreviewAsync()
    {
        if (IsEditorBusy) return;
        isPreparingPreview = true;
        isSubmitting = true;
        isSaving = true;
        saveFailed = false;
        ClearMessages();
        try
        {
            await SaveAllCoreAsync();
            saveFailed = errorMessage is not null;
            isSaving = false;
            if (HasUnsavedChanges || errorMessage is not null) return;
            await ConvertHtmlAsync();
            if (errorMessage is not null) return;
            NavigationManager.NavigateTo($"/articles/{ArticleId}/preview");
        }
        catch (Exception exception)
        {
            saveFailed = isSaving;
            errorMessage = "プレビューを準備できませんでした。入力内容を確認して、もう一度お試しください。";
            Logger.LogWarning("Preparing article preview failed. exceptionType={ExceptionType}", exception.GetType().Name);
        }
        finally
        {
            isSaving = false;
            isPreparingPreview = false;
            isSubmitting = false;
        }
    }

    private async Task DeleteArticleAsync()
    {
        using var scope = CreateOperationScope();
        var actor = await GetActorAsync();
        if (actor is null)
        {
            return;
        }

        var result = await scope.ServiceProvider.GetRequiredService<IArticleCommandService>().DeleteAsync(actor, ArticleId);
        if (!result.Succeeded)
        {
            errorMessage = GetServiceErrorMessage(result.Error, result.ValidationErrors);
            return;
        }

        savedForm = form with { };
        savedHeadingForm = headingForm with { };
        NavigationManager.NavigateTo("/articles");
    }

    private RenderFragment RenderHeadingButton(ArticleHeadingResponse heading) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "button");
        builder.AddAttribute(sequence++, "type", "button");
        builder.AddAttribute(sequence++, "class", GetHeadingButtonClass(heading));
        builder.AddAttribute(sequence++, "aria-current", selectedHeading?.Id == heading.Id ? "true" : null);
        builder.AddAttribute(sequence++, "title", heading.Title);
        builder.AddAttribute(sequence++, "onclick", EventCallback.Factory.Create(this, () => GuardAsync(() => SelectHeadingAsync(heading.Id))));
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "badge text-bg-light");
        builder.AddContent(sequence++, $"H{heading.Level}");
        builder.CloseElement();
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "article-outline-title");
        builder.AddContent(sequence++, heading.Title);
        builder.CloseElement();
        builder.OpenElement(sequence++, "span");
        builder.AddAttribute(sequence++, "class", "article-outline-count");
        builder.AddContent(sequence++, $"{heading.ActualLength ?? heading.Body?.Length ?? 0}字");
        builder.CloseElement();
        builder.CloseElement();
    };

    private IReadOnlyList<HeadingGroup> GetHeadingGroups()
    {
        if (article is null)
        {
            return [];
        }

        var ordered = article.Headings.OrderBy(heading => heading.DisplayOrder).ToArray();
        var h2Items = ordered.Where(heading => heading.Level == 2).ToArray();
        return h2Items
            .Select(heading => new HeadingGroup(
                heading,
                ordered.Where(child => child.ParentId == heading.Id).ToArray()))
            .ToArray();
    }

    private string GetHeadingButtonClass(ArticleHeadingResponse heading)
    {
        var classes = heading.Level == 3
            ? "article-outline-item article-outline-item-child"
            : "article-outline-item";

        return selectedHeading?.Id == heading.Id ? $"{classes} active" : classes;
    }

    private Guid? GetSelectedH2Id()
    {
        if (selectedHeading is null)
        {
            return null;
        }

        return selectedHeading.Level == 2 ? selectedHeading.Id : selectedHeading.ParentId;
    }

    private void ClearMessages()
    {
        errorMessage = null;
        successMessage = null;
    }

    private async Task<ArticleActor?> GetActorAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        return string.IsNullOrWhiteSpace(userId)
            ? null
            : new ArticleActor(userId, user.IsInRole("Admin"));
    }

    private static Guid? ParseGuid(string? value)
    {
        return Guid.TryParse(value, out var guid) ? guid : null;
    }

