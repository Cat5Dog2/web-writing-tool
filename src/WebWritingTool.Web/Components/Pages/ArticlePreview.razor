@page "/articles/{ArticleId:guid}/preview"
@attribute [Authorize]
@rendermode InteractiveServer
@inject IJSRuntime JS

@using System.Security.Claims
@using Microsoft.AspNetCore.Components
@using WebWritingTool.Application.Rendering

@inject IArticleQueryService ArticleQueryService
@inject IContentRenderingService ContentRenderingService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>記事プレビュー</PageTitle>

<div class="article-page article-preview-page">
    <header class="article-page-header">
        <div class="article-preview-heading">
            <h1>@(article?.Title ?? "記事プレビュー")</h1>
            @if (!string.IsNullOrWhiteSpace(article?.MetaDescription))
            {
                <p class="article-preview-description">@article.MetaDescription</p>
            }
        </div>
        <a class="btn btn-outline-secondary article-preview-back" href="@($"/articles/{ArticleId}")">編集に戻る</a>
    </header>

    @if (isLoading)
    {
        <div class="text-muted">読み込み中</div>
    }
    else if (article is null)
    {
        <div class="alert alert-warning" role="alert">記事が見つかりません。</div>
    }
    else if (string.IsNullOrWhiteSpace(sanitizedHtml))
    {
        <div class="alert alert-info" role="status">
            @(article.Headings.Count > 0 || !string.IsNullOrWhiteSpace(article.Body) ? "プレビューの更新が必要です。編集画面の「保存してプレビュー」で最新の内容を表示してください。" : "まだ本文がありません。編集画面で本文を作成してください。")
        </div>
    }
    else
    {
        <p class="small text-muted">保存した内容のプレビューです。編集後は「保存してプレビュー」で表示を更新できます。</p>
        @if (toc.Count > 0)
        {
            <nav class="article-panel preview-toc" aria-label="記事の目次">
                <h2 class="h5">目次</h2><ol>
                @foreach (var group in GetTocGroups())
                {
                    <li class="@($"level-{group.Heading.Level}")">
                        @RenderTocEntry(group.Heading)
                        @if (group.Children.Count > 0)
                        {
                            <ol>
                                @foreach (var child in group.Children)
                                {
                                    <li class="level-3">@RenderTocEntry(child)</li>
                                }
                            </ol>
                        }
                    </li>
                }
                </ol>
            </nav>
        }
        <article class="article-preview-body" @ref="bodyElement">
            @((MarkupString)sanitizedHtml)
        </article>
        <a class="btn btn-outline-primary mt-4" href="@($"/articles/{ArticleId}")">編集に戻る</a>
    }
</div>

@code {
    [Parameter]
    public Guid ArticleId { get; set; }

    private ElementReference bodyElement;
    private bool navigationReady;
    private IReadOnlyList<PreviewHeading> toc = [];
    private sealed record PreviewHeading(string Id, string Title, int Level)
    {
        public Guid? HeadingId { get; init; }
    }

    private sealed record PreviewHeadingGroup(PreviewHeading Heading, List<PreviewHeading> Children);

    private IReadOnlyList<PreviewHeadingGroup> GetTocGroups()
    {
        var groups = new List<PreviewHeadingGroup>();
        foreach (var heading in toc)
        {
            if (heading.Level == 3 && groups.LastOrDefault()?.Heading.Level == 2)
                groups[^1].Children.Add(heading);
            else
                groups.Add(new(heading, []));
        }
        return groups;
    }

    private RenderFragment RenderTocEntry(PreviewHeading item) => @<div class="preview-toc-entry">
        <a class="preview-toc-title" href="@($"/articles/{ArticleId}/preview#{item.Id}")">@item.Title</a>
        @if (item.HeadingId is Guid headingId)
        {
            <a class="preview-edit-link" href="@($"/articles/{ArticleId}?heading={headingId}")" aria-label="@($"{item.Title}を編集")">編集</a>
        }
    </div>;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (navigationReady || string.IsNullOrWhiteSpace(sanitizedHtml)) return;
        navigationReady = true;
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/previewNavigation.js");
        var headings = await module.InvokeAsync<PreviewHeading[]>("headings", bodyElement);
        var available = article!.Headings.OrderBy(h => h.DisplayOrder).ToList();
        toc = headings.Select(item =>
        {
            var match = available.FirstOrDefault(h => h.Level == item.Level && h.Title == item.Title);
            if (match is not null) available.Remove(match);
            return item with { HeadingId = match?.Id };
        }).ToArray();
        StateHasChanged();
    }

    private ArticleDetailResponse? article;
    private string sanitizedHtml = string.Empty;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        var actor = await GetActorAsync();
        if (actor is null)
        {
            isLoading = false;
            return;
        }

        article = await ArticleQueryService.GetAsync(actor, ArticleId);
        sanitizedHtml = article?.HtmlBody is null
            ? string.Empty
            : ContentRenderingService.SanitizeHtml(article.HtmlBody);
        isLoading = false;
    }

    private async Task<ArticleActor?> GetActorAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        return string.IsNullOrWhiteSpace(userId)
            ? null
            : new ArticleActor(userId, user.IsInRole("Admin"));
    }
}
