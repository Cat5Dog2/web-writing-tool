@inherits LayoutComponentBase

@inject Microsoft.Extensions.Options.IOptions<WebWritingTool.Web.Configuration.ExternalApiOptions> ExternalApiOptions

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <a href="account">@context.User.Identity?.Name</a>
                    <form method="post" action="/logout" class="ms-3">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-link p-0">ログアウト</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="login">ログイン</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @if (ExternalApiOptions.Value.UseMocks)
            {
                <div class="alert alert-info" role="status">
                    <strong>ダミーモード</strong>：記事・検索結果・X投稿は動作確認用のサンプルです。外部API・WordPress投稿・Discord通知は利用しません。
                </div>
            }
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
