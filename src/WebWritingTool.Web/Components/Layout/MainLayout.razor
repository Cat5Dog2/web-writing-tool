@inherits LayoutComponentBase

@inject Microsoft.Extensions.Options.IOptions<WebWritingTool.Web.Configuration.ExternalApiOptions> ExternalApiOptions

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <a href="account">@(WebWritingTool.Application.Security.GuestIdentity.IsGuest(context.User) ? "ゲスト" : context.User.Identity?.Name)</a>
                    <form method="post" action="/logout" class="ms-3">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-link p-0">ログアウト</button>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <a href="login">ログイン</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            <AuthorizeView>
                <Authorized>
                    @if (WebWritingTool.Application.Security.GuestIdentity.IsGuest(context.User))
                    {
                        <details class="guest-mode-banner">
                            <summary><strong>ゲストモード</strong> · サンプルで記事作成を体験</summary>
                            <p class="mb-1">生成・検索はサンプルです。外部APIへの接続、WordPress投稿、Discord通知は行いません。</p>
                            <a href="/account">利用期限とデータの扱いを確認</a>
                        </details>
                    }
                </Authorized>
            </AuthorizeView>
            @if (ExternalApiOptions.Value.UseMocks)
            {
                <div class="alert alert-info" role="status">
                    <strong>ダミーモード</strong>：記事・検索結果・X投稿は動作確認用のサンプルです。外部API・WordPress投稿・Discord通知は利用しません。
                </div>
            }
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    接続または処理でエラーが発生しました。入力中の内容を控えてから再読み込みしてください。
    <a href="." class="reload">再読み込み</a>
    <span class="dismiss">🗙</span>
</div>
