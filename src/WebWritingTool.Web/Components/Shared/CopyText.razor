@inject IJSRuntime JS
<button class="btn btn-sm btn-outline-secondary" @onclick="CopyAsync">@Label</button>
<span class="small ms-2" role="status">@status</span>
@code {
    [Parameter] public string Label { get; set; } = "識別番号をコピー";
    [Parameter] public string Text { get; set; } = string.Empty;
    private string? status;
    private async Task CopyAsync()
    {
        try
        {
            await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/appDialog.js");
            await module.InvokeVoidAsync("copy", Text);
            status = "コピーしました。";
        }
        catch (JSException) { status = "コピーできませんでした。テキストを選択してコピーしてください。"; }
    }
}
